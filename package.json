{
  "name": "bible-study-tool",
  "private": false,
  "version": "1.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "convert-translations": "node scripts/convert-translations.cjs",
    "audit-calvin-commentary": "node scripts/audit-calvin-commentary.cjs",
    "parse-docx": "node scripts/parseDocx.js",
    "deploy": "npm run build && gh-pages -d dist",
    "android:sync": "npm run build && npx cap sync android",
    "android:run": "npm run build && npx cap run android",
    "android:build:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.3.0",
    "mammoth": "^1.6.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0"
  }
}
