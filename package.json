{
  "name": "bible-study-tool",
  "private": true,
  "version": "1.1.27",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit && npm run test:protocol",
    "test:unit": "vitest run",
    "test:protocol": "node --test tests/*.test.mjs",
    "build": "vite build",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "convert-translations": "node scripts/convert-translations.cjs",
    "audit-calvin-commentary": "node scripts/audit-calvin-commentary.cjs",
    "parse-docx": "node scripts/parseDocx.js",
    "deploy": "npm run build && gh-pages -d dist",
    "android:sync": "npm run build && npx cap sync android",
    "android:run": "npm run build && npx cap run android",
    "android:build:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "mammoth": "^1.6.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
