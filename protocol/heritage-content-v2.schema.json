{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage.faith/protocol/heritage-content-v2.schema.json",
  "title": "Heritage Content Server Manifest v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "kind", "id", "name", "catalogs"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "heritage-content-server" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "publisher": { "type": "string" },
    "website": { "type": "string", "format": "uri" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "catalogs": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "readingPlans": { "$ref": "#/$defs/catalogReference" },
        "songs": { "$ref": "#/$defs/catalogReference" },
        "sermons": { "$ref": "#/$defs/catalogReference" },
        "books": { "$ref": "#/$defs/catalogReference" },
        "commentaries": { "$ref": "#/$defs/catalogReference" }
      }
    }
  },
  "$defs": {
    "catalogReference": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["url"],
          "properties": { "url": { "type": "string", "minLength": 1 } }
        }
      ]
    }
  }
}
