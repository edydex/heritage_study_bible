},{"id":10,"source":[61,65],"target":[67,70]},{"id":9,"source":[53,60],"target":[71,83]},{"id":11,"source":[66,69],"target":[84,103]},{"id":14,"source":[79,87],"target":[104,115]},{"id":12,"source":[70,72],"target":[116,122]},{"id":13,"source":[73,78],"target":[123,130]}]},"2:8":{"sourceText":"καὶ τότε ἀποκαλυφθήσεται ὁ ἄνομος, ὃν ὁ Κύριος Ἰησοῦς ἀνελεῖ τῷ πνεύματι τοῦ στόματος αὐτοῦ καὶ καταργήσει τῇ ἐπιφανείᾳ τῆς παρουσίας αὐτοῦ,","targetText":"And then the lawless one will be revealed, whom the Lord Jesus will slay with the breath of His mouth and annihilate by the majesty of His arrival.","groups":[{"id":0,"source":[0,3],"target":[0,3]},{"id":1,"source":[4,8],"target":[4,8]},{"id":3,"source":[25,26],"target":[9,12]},{"id":4,"source":[27,34],"target":[13,24]},{"id":2,"source":[9,24],"target":[25,41]},{"id":5,"source":[35,37],"target":[43,47]},{"id":6,"source":[38,39],"target":[48,51]},{"id":7,"source":[40,46],"target":[52,56]},{"id":8,"source":[47,53],"target":[57,62]},{"id":9,"source":[54,60],"target":[63,72]},{"id":10,"source":[61,63],"target":[73,81]},{"id":11,"source":[64,72],"target":[82,88]},{"id":12,"source":[73,76],"target":[89,91]},{"id":14,"source":[86,91],"target":[92,95]},{"id":13,"source":[77,85],"target":[96,101]},{"id":15,"source":[92,95],"target":[102,105]},{"id":16,"source":[96,106],"target":[106,116]},{"id":17,"source":[107,109],"target":[117,123]},{"id":18,"source":[110,119],"target":[124,131]},{"id":19,"source":[120,123],"target":[132,134]},{"id":21,"source":[134,140],"target":[135,138]},{"id":20,"source":[124,133],"target":[139,146]}]},"2:9":{"sourceText":"οὗ ἐστιν ἡ παρουσία κατ’ ἐνέργειαν τοῦ Σατανᾶ ἐν πάσῃ δυνάμει καὶ σημείοις καὶ τέρασιν ψεύδους","targetText":"The coming of the lawless one will be accompanied by the working of Satan, with every kind of power, sign, and false wonder,","groups":[{"id":2,"source":[9,10],"target":[0,3]},{"id":3,"source":[11,19],"target":[4,29]},{"id":1,"source":[3,8],"target":[30,37]},{"id":4,"source":[20,24],"target":[38,52]},{"id":5,"source":[25,34],"target":[53,64]},{"id":7,"source":[39,45],"target":[65,73]},{"id":8,"source":[46,48],"target":[75,79]},{"id":9,"source":[49,53],"target":[80,93]},{"id":10,"source":[54,61],"target":[94,99]},{"id":12,"source":[66,74],"target":[101,105]},{"id":13,"source":[75,78],"target":[107,110]},{"id":15,"source":[87,94],"target":[111,116]},{"id":14,"source":[79,86],"target":[117,123]}]},"2:10":{"sourceText":"καὶ ἐν πάσῃ ἀπάτῃ ἀδικίας τοῖς ἀπολλυμένοις, ἀνθ’ ὧν τὴν ἀγάπην τῆς ἀληθείας οὐκ ἐδέξαντο εἰς τὸ σωθῆναι αὐτούς.","targetText":"and with every wicked deception directed against those who are perishing, because they refused the love of the truth that would have saved them.","groups":[{"id":0,"source":[0,3],"target":[0,3]},{"id":1,"source":[4,6],"target":[4,8]},{"id":2,"source":[7,11],"target":[9,14]},{"id":4,"source":[18,25],"target":[15,21]},{"id":3,"source":[12,17],"target":[22,31]},{"id":5,"source":[26,30],"target":[32,58]},{"id":6,"source":[31,44],"target":[59,72]},{"id":7,"source":[45,49],"target":[74,81]},{"id":14,"source":[81,89],"target":[82,94]},{"id":9,"source":[53,56],"target":[95,98]},{"id":10,"source":[57,63],"target":[99,103]},{"id":11,"source":[64,67],"target":[104,110]},{"id":12,"source":[68,76],"target":[111,116]},{"id":15,"source":[90,93],"target":[117,132]},{"id":17,"source":[97,104],"target":[133,138]},{"id":18,"source":[105,112],"target":[139,143]}]},"2:11":{"sourceText":"καὶ διὰ τοῦτο πέμπει αὐτοῖς ὁ Θεὸς ἐνέργειαν πλάνης εἰς τὸ πιστεῦσαι αὐτοὺς τῷ ψεύδει,","targetText":"For this reason God will send them a powerful delusion so that they believe the lie,","groups":[{"id":1,"source":[4,7],"target":[0,15]},{"id":6,"source":[30,34],"target":[16,19]},{"id":3,"source":[14,20],"target":[20,29]},{"id":4,"source":[21,27],"target":[30,34]},{"id":7,"source":[35,44],"target":[35,45]},{"id":8,"source":[45,51],"target":[46,54]},{"id":9,"source":[52,55],"target":[55,62]},{"id":12,"source":[69,75],"target":[63,67]},{"id":11,"source":[59,68],"target":[68,75]},{"id":14,"source":[79,86],"target":[76,83]}]},"2:12":{"sourceText":"ἵνα κριθῶσιν πάντες οἱ μὴ πιστεύσαντες τῇ ἀληθείᾳ ἀλλὰ εὐδοκήσαντες τῇ ἀδικίᾳ.","targetText":"in order that judgment may come upon all who have disbelieved the truth and delighted in wickedness.","groups":[{"id":0,"source":[0,3],"target":[0,13]},{"id":1,"source":[4,12],"target":[14,36]},{"id":2,"source":[13,19],"target":[37,40]},{"id":3,"source":[20,22],"target":[41,44]},{"id":5,"source":[26,38],"target":[45,61]},{"id":6,"source":[39,41],"target":[62,65]},{"id":7,"source":[42,49],"target":[66,71]},{"id":8,"source":[50,54],"target":[72,75]},{"id":9,"source":[55,67],"target":[76,85]},{"id":11,"source":[71,78],"target":[86,99]}]},"2:14":{"sourceText":"εἰς ὃ καὶ ἐκάλεσεν ὑμᾶς διὰ τοῦ εὐαγγελίου ἡμῶν, εἰς περιποίησιν δόξης τοῦ Κυρίου ἡμῶν Ἰησοῦ Χριστοῦ.","targetText":"To this He called you through our gospel, so that you may share in the glory of our Lord Jesus Christ.","groups":[{"id":0,"source":[0,3],"target":[0,2]},{"id":1,"source":[4,5],"target":[3,7]},{"id":3,"source":[10,18],"target":[8,17]},{"id":4,"source":[19,23],"target":[18,21]},{"id":5,"source":[24,27],"target":[22,29]},{"id":8,"source":[43,48],"target":[30,33]},{"id":7,"source":[32,42],"target":[34,40]},{"id":9,"source":[49,52],"target":[42,49]},{"id":10,"source":[53,64],"target":[50,66]},{"id":11,"source":[65,70],"target":[67,76]},{"id":14,"source":[82,86],"target":[77,83]},{"id":13,"source":[75,81],"target":[84,88]},{"id":15,"source":[87,92],"target":[89,94]},{"id":16,"source":[93,101],"target":[95,101]}]},"2:15":{"sourceText":"Ἄρα οὖν, ἀδελφοί, στήκετε, καὶ κρατεῖτε τὰς παραδόσεις ἃς ἐδιδάχθητε εἴτε διὰ λόγου εἴτε δι’ ἐπιστολῆς ἡμῶν.","targetText":"Therefore, brothers, stand firm and cling to the traditions we taught you, whether by speech or by letter.","groups":[{"id":0,"source":[0,3],"target":[0,9]},{"id":2,"source":[9,17],"target":[11,19]},{"id":3,"source":[18,26],"target":[21,31]},{"id":4,"source":[27,30],"target":[32,35]},{"id":5,"source":[31,39],"target":[36,41]},{"id":6,"source":[40,43],"target":[42,48]},{"id":7,"source":[44,54],"target":[49,59]},{"id":16,"source":[103,108],"target":[60,62]},{"id":9,"source":[58,68],"target":[63,73]},{"id":10,"source":[69,73],"target":[75,82]},{"id":11,"source":[74,77],"target":[83,85]},{"id":12,"source":[78,83],"target":[86,92]},{"id":13,"source":[84,88],"target":[93,95]},{"id":14,"source":[89,92],"target":[96,98]},{"id":15,"source":[93,102],"target":[99,105]}]},"2:16":{"sourceText":"Αὐτὸς δὲ ὁ Κύριος ἡμῶν Ἰησοῦς Χριστὸς καὶ ὁ Θεὸς ὁ Πατὴρ ἡμῶν, ὁ ἀγαπήσας ἡμᾶς καὶ δοὺς παράκλησιν αἰωνίαν καὶ ἐλπίδα ἀγαθὴν ἐν χάριτι,","targetText":"Now may our Lord Jesus Christ Himself and God our Father, who by grace has loved us and given us eternal comfort and good hope,","groups":[{"id":1,"source":[6,8],"target":[0,7]},{"id":4,"source":[18,22],"target":[8,11]},{"id":3,"source":[11,17],"target":[12,16]},{"id":5,"source":[23,29],"target":[17,22]},{"id":6,"source":[30,37],"target":[23,29]},{"id":0,"source":[0,5],"target":[30,37]},{"id":7,"source":[38,41],"target":[38,41]},{"id":9,"source":[44,48],"target":[42,45]},{"id":12,"source":[57,62],"target":[46,49]},{"id":11,"source":[51,56],"target":[50,56]},{"id":13,"source":[63,64],"target":[58,61]},{"id":23,"source":[125,127],"target":[62,64]},{"id":24,"source":[128,135],"target":[65,70]},{"id":14,"source":[65,73],"target":[71,80]},{"id":15,"source":[74,78],"target":[81,83]},{"id":16,"source":[79,82],"target":[84,87]},{"id":17,"source":[83,87],"target":[88,96]},{"id":19,"source":[99,106],"target":[97,104]},{"id":18,"source":[88,98],"target":[105,112]},{"id":20,"source":[107,110],"target":[113,116]},{"id":22,"source":[118,124],"target":[117,121]},{"id":21,"source":[111,117],"target":[122,126]}]},"2:17":{"sourceText":"παρακαλέσαι ὑμῶν τὰς καρδίας καὶ στηρίξαι ἐν παντὶ ἔργῳ καὶ λόγῳ ἀγαθῷ.","targetText":"encourage your hearts and strengthen you in every good word and deed.","groups":[{"id":0,"source":[0,11],"target":[0,9]},{"id":1,"source":[12,16],"target":[10,14]},{"id":3,"source":[21,28],"target":[15,21]},{"id":4,"source":[29,32],"target":[22,25]},{"id":5,"source":[33,41],"target":[26,40]},{"id":6,"source":[42,44],"target":[41,43]},{"id":7,"source":[45,50],"target":[44,49]},{"id":11,"source":[65,71],"target":[50,54]},{"id":10,"source":[60,64],"target":[55,59]},{"id":9,"source":[56,59],"target":[60,63]},{"id":8,"source":[51,55],"target":[64,68]}]},"3:1":{"sourceText":"Τὸ λοιπὸν προσεύχεσθε, ἀδελφοί, περὶ ἡμῶν, ἵνα ὁ λόγος τοῦ Κυρίου τρέχῃ καὶ δοξάζηται καθὼς καὶ πρὸς ὑμᾶς,","targetText":"Finally, brothers, pray for us, that the word of the Lord may spread quickly and be held in honor, just as it was with you.","groups":[{"id":1,"source":[3,9],"target":[0,7]},{"id":3,"source":[23,31],"target":[9,17]},{"id":2,"source":[10,22],"target":[19,23]},{"id":4,"source":[32,36],"target":[24,27]},{"id":5,"source":[37,42],"target":[28,30]},{"id":6,"source":[43,46],"target":[32,36]},{"id":7,"source":[47,48],"target":[37,40]},{"id":8,"source":[49,54],"target":[41,45]},{"id":9,"source":[55,58],"target":[46,52]},{"id":10,"source":[59,65],"target":[53,57]},{"id":11,"source":[66,71],"target":[58,76]},{"id":12,"source":[72,75],"target":[77,80]},{"id":13,"source":[76,85],"target":[81,97]},{"id":14,"source":[86,91],"target":[99,106]},{"id":15,"source":[92,95],"target":[107,113]},{"id":16,"source":[96,100],"target":[114,118]},{"id":17,"source":[101,106],"target":[119,122]}]},"3:2":{"sourceText":"καὶ ἵνα ῥυσθῶμεν ἀπὸ τῶν ἀτόπων καὶ πονηρῶν ἀνθρώπων· οὐ γὰρ πάντων ἡ πίστις.","targetText":"And pray that we may be delivered from wicked and evil men; for not everyone holds to the faith.","groups":[{"id":0,"source":[0,3],"target":[0,8]},{"id":1,"source":[4,7],"target":[9,13]},{"id":2,"source":[8,16],"target":[14,33]},{"id":3,"source":[17,20],"target":[34,38]},{"id":5,"source":[25,31],"target":[39,45]},{"id":6,"source":[32,35],"target":[46,49]},{"id":7,"source":[36,43],"target":[50,54]},{"id":8,"source":[44,53],"target":[55,58]},{"id":10,"source":[57,60],"target":[60,63]},{"id":9,"source":[54,56],"target":[64,67]},{"id":11,"source":[61,67],"target":[68,85]},{"id":12,"source":[68,69],"target":[86,89]},{"id":13,"source":[70,77],"target":[90,95]}]},"3:3":{"sourceText":"Πιστὸς δέ ἐστιν ὁ Κύριος, ὃς στηρίξει ὑμᾶς καὶ φυλάξει ἀπὸ τοῦ πονηροῦ.","targetText":"But the Lord is faithful, and He will strengthen you and guard you from the evil one.","groups":[{"id":1,"source":[7,9],"target":[0,3]},{"id":3,"source":[16,17],"target":[4,7]},{"id":4,"source":[18,25],"target":[8,12]},{"id":2,"source":[10,15],"target":[13,15]},{"id":0,"source":[0,6],"target":[16,24]},{"id":5,"source":[26,28],"target":[26,32]},{"id":6,"source":[29,37],"target":[33,52]},{"id":8,"source":[43,46],"target":[53,56]},{"id":9,"source":[47,54],"target":[57,62]},{"id":7,"source":[38,42],"target":[63,66]},{"id":10,"source":[55,58],"target":[67,71]},{"id":11,"source":[59,62],"target":[72,75]},{"id":12,"source":[63,71],"target":[76,84]}]},"3:4":{"sourceText":"πεποίθαμεν δὲ ἐν Κυρίῳ ἐφ’ ὑμᾶς, ὅτι ἃ παραγγέλλομεν καὶ ποιεῖτε καὶ ποιήσετε.","targetText":"And we have confidence in the Lord that you are doing and will continue to do what we command.","groups":[{"id":1,"source":[11,13],"target":[0,3]},{"id":0,"source":[0,10],"target":[4,22]},{"id":2,"source":[14,16],"target":[23,25]},{"id":3,"source":[17,22],"target":[26,34]},{"id":6,"source":[33,36],"target":[35,39]},{"id":10,"source":[57,64],"target":[40,53]},{"id":11,"source":[65,68],"target":[54,57]},{"id":12,"source":[69,78],"target":[58,77]},{"id":7,"source":[37,38],"target":[78,82]},{"id":8,"source":[39,52],"target":[83,93]}]},"3:5":{"sourceText":"Ὁ δὲ Κύριος κατευθύναι ὑμῶν τὰς καρδίας εἰς τὴν ἀγάπην τοῦ Θεοῦ καὶ εἰς τὴν ὑπομονὴν τοῦ Χριστοῦ.","targetText":"May the Lord direct your hearts into God’s love and Christ’s perseverance.","groups":[{"id":0,"source":[0,1],"target":[0,7]},{"id":2,"source":[5,11],"target":[8,12]},{"id":3,"source":[12,22],"target":[13,19]},{"id":4,"source":[23,27],"target":[20,24]},{"id":6,"source":[32,39],"target":[25,31]},{"id":7,"source":[40,43],"target":[32,36]},{"id":11,"source":[59,63],"target":[37,42]},{"id":9,"source":[48,54],"target":[43,47]},{"id":12,"source":[64,67],"target":[48,51]},{"id":17,"source":[89,97],"target":[52,60]},{"id":15,"source":[76,84],"target":[61,73]}]},"3:7":{"sourceText":"αὐτοὶ γὰρ οἴδατε πῶς δεῖ μιμεῖσθαι ἡμᾶς, ὅτι οὐκ ἠτακτήσαμεν ἐν ὑμῖν,","targetText":"For you yourselves know how you ought to imitate us, because we were not undisciplined among you,","groups":[{"id":1,"source":[6,9],"target":[0,3]},{"id":0,"source":[0,5],"target":[4,18]},{"id":2,"source":[10,16],"target":[19,23]},{"id":3,"source":[17,20],"target":[24,27]},{"id":4,"source":[21,24],"target":[28,37]},{"id":5,"source":[25,34],"target":[38,48]},{"id":6,"source":[35,40],"target":[49,51]},{"id":7,"source":[41,44],"target":[53,60]},{"id":9,"source":[49,60],"target":[61,86]},{"id":10,"source":[61,63],"target":[87,92]},{"id":11,"source":[64,69],"target":[93,96]}]},"3:8":{"sourceText":"οὐδὲ δωρεὰν ἄρτον ἐφάγομεν παρά τινος, ἀλλ’ ἐν κόπῳ καὶ μόχθῳ νυκτὸς καὶ ἡμέρας ἐργαζόμενοι πρὸς τὸ μὴ ἐπιβαρῆσαί τινα ὑμῶν·","targetText":"nor did we eat anyone’s food without paying for it. Instead, in labor and toil, we worked night and day so that we would not be a burden to any of you.","groups":[{"id":0,"source":[0,4],"target":[0,3]},{"id":3,"source":[18,26],"target":[4,14]},{"id":5,"source":[32,38],"target":[15,23]},{"id":2,"source":[12,17],"target":[24,28]},{"id":1,"source":[5,11],"target":[29,50]},{"id":6,"source":[39,43],"target":[52,59]},{"id":7,"source":[44,46],"target":[61,63]},{"id":8,"source":[47,51],"target":[64,69]},{"id":9,"source":[52,55],"target":[70,73]},{"id":10,"source":[56,61],"target":[74,78]},{"id":14,"source":[80,91],"target":[80,89]},{"id":11,"source":[62,68],"target":[90,95]},{"id":12,"source":[69,72],"target":[96,99]},{"id":13,"source":[73,79],"target":[100,103]},{"id":15,"source":[92,96],"target":[104,111]},{"id":18,"source":[103,113],"target":[112,136]},{"id":19,"source":[114,118],"target":[137,143]},{"id":20,"source":[119,124],"target":[144,150]}]},"3:9":{"sourceText":"οὐχ ὅτι οὐκ ἔχομεν ἐξουσίαν, ἀλλ’ ἵνα ἑαυτοὺς τύπον δῶμεν ὑμῖν εἰς τὸ μιμεῖσθαι ἡμᾶς.","targetText":"Not that we lack this right, but we wanted to offer ourselves as an example for you to imitate.","groups":[{"id":0,"source":[0,3],"target":[0,3]},{"id":1,"source":[4,7],"target":[4,8]},{"id":3,"source":[12,18],"target":[9,16]},{"id":4,"source":[19,28],"target":[17,27]},{"id":5,"source":[29,33],"target":[29,32]},{"id":6,"source":[34,37],"target":[33,45]},{"id":9,"source":[52,57],"target":[46,51]},{"id":7,"source":[38,45],"target":[52,61]},{"id":8,"source":[46,51],"target":[62,75]},{"id":10,"source":[58,62],"target":[76,83]},{"id":11,"source":[63,66],"target":[84,86]},{"id":13,"source":[70,79],"target":[87,94]}]},"3:10":{"sourceText":"καὶ γὰρ ὅτε ἦμεν πρὸς ὑμᾶς, τοῦτο παρηγγέλλομεν ὑμῖν, ὅτι εἴ τις οὐ θέλει ἐργάζεσθαι, μηδὲ ἐσθιέτω.","targetText":"For even while we were with you, we gave you this command: “If anyone is unwilling to work, he shall not eat.”","groups":[{"id":1,"source":[4,7],"target":[0,3]},{"id":0,"source":[0,3],"target":[4,8]},{"id":2,"source":[8,11],"target":[9,14]},{"id":3,"source":[12,16],"target":[15,22]},{"id":4,"source":[17,21],"target":[23,27]},{"id":5,"source":[22,27],"target":[28,31]},{"id":7,"source":[34,47],"target":[33,57]},{"id":10,"source":[58,60],"target":[60,62]},{"id":11,"source":[61,64],"target":[63,69]},{"id":13,"source":[68,73],"target":[70,82]},{"id":14,"source":[74,85],"target":[83,90]},{"id":16,"source":[91,99],"target":[92,108]}]},"3:12":{"sourceText":"τοῖς δὲ τοιούτοις παραγγέλλομεν καὶ παρακαλοῦμεν ἐν Κυρίῳ Ἰησοῦ Χριστῷ ἵνα μετὰ ἡσυχίας ἐργαζόμενοι τὸν ἑαυτῶν ἄρτον ἐσθίωσιν.","targetText":"We command and urge such people by our Lord Jesus Christ to begin working quietly to earn their own living.","groups":[{"id":3,"source":[18,31],"target":[0,10]},{"id":4,"source":[32,35],"target":[11,14]},{"id":5,"source":[36,48],"target":[15,19]},{"id":2,"source":[8,17],"target":[20,31]},{"id":6,"source":[49,51],"target":[32,34]},{"id":7,"source":[52,57],"target":[35,43]},{"id":8,"source":[58,63],"target":[44,49]},{"id":9,"source":[64,70],"target":[50,56]},{"id":10,"source":[71,74],"target":[57,59]},{"id":13,"source":[88,99],"target":[60,73]},{"id":12,"source":[80,87],"target":[74,81]},{"id":17,"source":[117,126],"target":[82,106]}]},"3:13":{"sourceText":"Ὑμεῖς δέ, ἀδελφοί, μὴ ἐγκακήσητε καλοποιοῦντες.","targetText":"But as for you, brothers, do not grow weary in well-doing.","groups":[{"id":1,"source":[6,9],"target":[0,10]},{"id":0,"source":[0,5],"target":[11,14]},{"id":2,"source":[10,18],"target":[16,24]},{"id":3,"source":[19,21],"target":[26,32]},{"id":4,"source":[22,32],"target":[33,43]},{"id":5,"source":[33,47],"target":[44,57]}]},"3:14":{"sourceText":"εἰ δέ τις οὐχ ὑπακούει τῷ λόγῳ ἡμῶν διὰ τῆς ἐπιστολῆς, τοῦτον σημειοῦσθε, μὴ συναναμίγνυσθαι αὐτῷ, ἵνα ἐντραπῇ·","targetText":"Take note of anyone who does not obey the instructions we have given in this letter. Do not associate with him, so that he may be ashamed.","groups":[{"id":12,"source":[62,73],"target":[0,9]},{"id":11,"source":[55,61],"target":[10,12]},{"id":2,"source":[6,9],"target":[13,23]},{"id":3,"source":[10,13],"target":[24,32]},{"id":4,"source":[14,22],"target":[33,37]},{"id":5,"source":[23,25],"target":[38,41]},{"id":6,"source":[26,30],"target":[42,68]},{"id":8,"source":[36,39],"target":[69,71]},{"id":9,"source":[40,43],"target":[72,76]},{"id":10,"source":[44,54],"target":[77,83]},{"id":13,"source":[74,76],"target":[85,91]},{"id":14,"source":[77,92],"target":[92,106]},{"id":15,"source":[93,98],"target":[107,110]},{"id":16,"source":[99,102],"target":[112,119]},{"id":17,"source":[103,111],"target":[120,137]}]},"3:16":{"sourceText":"Αὐτὸς δὲ ὁ Κύριος τῆς εἰρήνης δῴη ὑμῖν τὴν εἰρήνην διὰ παντὸς ἐν παντὶ τρόπῳ. ὁ Κύριος μετὰ πάντων ὑμῶν.","targetText":"Now may the Lord of peace Himself give you peace at all times and in every way. The Lord be with all of you.","groups":[{"id":1,"source":[6,8],"target":[0,3]},{"id":2,"source":[9,10],"target":[4,11]},{"id":3,"source":[11,17],"target":[12,16]},{"id":5,"source":[22,29],"target":[17,25]},{"id":0,"source":[0,5],"target":[26,33]},{"id":6,"source":[30,33],"target":[34,38]},{"id":7,"source":[34,38],"target":[39,42]},{"id":9,"source":[43,50],"target":[43,48]},{"id":10,"source":[51,54],"target":[49,51]},{"id":11,"source":[55,61],"target":[52,61]},{"id":12,"source":[62,64],"target":[62,68]},{"id":13,"source":[65,70],"target":[69,74]},{"id":14,"source":[71,77],"target":[75,78]},{"id":15,"source":[78,79],"target":[80,83]},{"id":16,"source":[80,86],"target":[84,91]},{"id":17,"source":[87,91],"target":[92,96]},{"id":18,"source":[92,98],"target":[97,100]},{"id":19,"source":[99,104],"target":[101,107]}]},"3:17":{"sourceText":"Ὁ ἀσπασμὸς τῇ ἐμῇ χειρὶ Παύλου, ὅ ἐστιν σημεῖον ἐν πάσῃ ἐπιστολῇ· οὕτως γράφω.","targetText":"This greeting is in my own hand—Paul. This is my mark in every letter; it is the way I write.","groups":[{"id":0,"source":[0,1],"target":[0,4]},{"id":1,"source":[2,10],"target":[5,16]},{"id":3,"source":[14,17],"target":[17,26]},{"id":4,"source":[18,23],"target":[27,31]},{"id":5,"source":[24,31],"target":[32,36]},{"id":6,"source":[32,33],"target":[38,42]},{"id":7,"source":[34,39],"target":[43,45]},{"id":8,"source":[40,47],"target":[46,53]},{"id":9,"source":[48,50],"target":[54,56]},{"id":10,"source":[51,55],"target":[57,62]},{"id":11,"source":[56,65],"target":[63,69]},{"id":12,"source":[66,71],"target":[71,84]},{"id":13,"source":[72,78],"target":[85,92]}]},"3:18":{"sourceText":"ἡ χάρις τοῦ Κυρίου ἡμῶν Ἰησοῦ Χριστοῦ μετὰ πάντων ὑμῶν.","targetText":"The grace of our Lord Jesus Christ be with all of you.","groups":[{"id":0,"source":[0,1],"target":[0,3]},{"id":1,"source":[2,7],"target":[4,9]},{"id":4,"source":[19,23],"target":[10,16]},{"id":3,"source":[12,18],"target":[17,21]},{"id":5,"source":[24,29],"target":[22,27]},{"id":6,"source":[30,37],"target":[28,34]},{"id":7,"source":[38,42],"target":[35,42]},{"id":8,"source":[43,49],"target":[43,46]},{"id":9,"source":[50,55],"target":[47,53]}]}},"unavailable":{"1:2":"greek-edition-differs","2:6":"greek-edition-differs","2:13":"english-edition-differs","3:6":"greek-edition-differs","3:11":"english-edition-differs","3:15":"english-edition-differs"}}
