,"groups":[{"id":1,"source":[12,21],"target":[0,16]},{"id":0,"source":[0,11],"target":[17,25]},{"id":3,"source":[25,28],"target":[26,29]},{"id":5,"source":[37,41],"target":[30,33]},{"id":6,"source":[42,47],"target":[34,37]},{"id":4,"source":[29,36],"target":[38,50]},{"id":7,"source":[48,56],"target":[52,60]},{"id":8,"source":[57,62],"target":[62,64]},{"id":10,"source":[69,75],"target":[65,67]},{"id":9,"source":[63,68],"target":[68,75]},{"id":11,"source":[76,79],"target":[77,84]},{"id":15,"source":[101,105],"target":[85,89]},{"id":14,"source":[94,100],"target":[90,95]},{"id":12,"source":[80,91],"target":[96,120]},{"id":16,"source":[106,109],"target":[122,125]},{"id":23,"source":[148,152],"target":[126,130]},{"id":19,"source":[122,127],"target":[131,135]},{"id":24,"source":[153,156],"target":[136,139]},{"id":25,"source":[157,166],"target":[140,151]},{"id":17,"source":[110,119],"target":[152,165]}]},"1:4":{"sourceText":"ὥστε αὐτοὺς ἡμᾶς ἐν ὑμῖν ἐνκαυχᾶσθαι ἐν ταῖς ἐκκλησίαις τοῦ Θεοῦ ὑπὲρ τῆς ὑπομονῆς ὑμῶν καὶ πίστεως ἐν πᾶσιν τοῖς διωγμοῖς ὑμῶν καὶ ταῖς θλίψεσιν αἷς ἀνέχεσθε,","targetText":"That is why we boast among God’s churches about your perseverance and faith in the face of all the persecution and affliction you are enduring.","groups":[{"id":0,"source":[0,4],"target":[0,11]},{"id":2,"source":[12,16],"target":[12,14]},{"id":5,"source":[25,36],"target":[15,20]},{"id":6,"source":[37,39],"target":[21,26]},{"id":10,"source":[60,64],"target":[27,32]},{"id":8,"source":[45,55],"target":[33,41]},{"id":11,"source":[65,69],"target":[42,47]},{"id":14,"source":[83,87],"target":[48,52]},{"id":13,"source":[74,82],"target":[53,65]},{"id":15,"source":[88,91],"target":[66,69]},{"id":16,"source":[92,99],"target":[70,75]},{"id":17,"source":[100,102],"target":[76,90]},{"id":18,"source":[103,108],"target":[91,94]},{"id":21,"source":[123,127],"target":[95,98]},{"id":20,"source":[114,122],"target":[99,110]},{"id":22,"source":[128,131],"target":[111,114]},{"id":24,"source":[137,145],"target":[115,125]},{"id":26,"source":[150,159],"target":[126,142]}]},"1:5":{"sourceText":"ἔνδειγμα τῆς δικαίας κρίσεως τοῦ Θεοῦ, εἰς τὸ καταξιωθῆναι ὑμᾶς τῆς βασιλείας τοῦ Θεοῦ, ὑπὲρ ἧς καὶ πάσχετε,","targetText":"All this is clear evidence of God’s righteous judgment. And so you will be counted worthy of the kingdom of God, for which you are suffering.","groups":[{"id":0,"source":[0,8],"target":[0,26]},{"id":5,"source":[33,38],"target":[27,35]},{"id":2,"source":[13,20],"target":[36,45]},{"id":3,"source":[21,28],"target":[46,54]},{"id":6,"source":[39,42],"target":[56,62]},{"id":9,"source":[59,63],"target":[63,66]},{"id":8,"source":[46,58],"target":[67,89]},{"id":10,"source":[64,67],"target":[90,96]},{"id":11,"source":[68,77],"target":[97,104]},{"id":13,"source":[82,87],"target":[105,111]},{"id":14,"source":[88,92],"target":[113,116]},{"id":15,"source":[93,95],"target":[117,122]},{"id":17,"source":[100,108],"target":[123,140]}]},"1:6":{"sourceText":"εἴπερ δίκαιον παρὰ Θεῷ ἀνταποδοῦναι τοῖς θλίβουσιν ὑμᾶς θλῖψιν","targetText":"After all, it is only right for God to repay with affliction those who afflict you,","groups":[{"id":0,"source":[0,5],"target":[0,9]},{"id":1,"source":[6,13],"target":[11,27]},{"id":2,"source":[14,18],"target":[28,31]},{"id":3,"source":[19,22],"target":[32,35]},{"id":4,"source":[23,35],"target":[36,44]},{"id":8,"source":[56,62],"target":[45,60]},{"id":5,"source":[36,40],"target":[61,70]},{"id":6,"source":[41,50],"target":[71,78]},{"id":7,"source":[51,55],"target":[79,82]}]},"1:7":{"sourceText":"καὶ ὑμῖν τοῖς θλιβομένοις ἄνεσιν μεθ’ ἡμῶν, ἐν τῇ ἀποκαλύψει τοῦ Κυρίου Ἰησοῦ ἀπ’ οὐρανοῦ μετ’ ἀγγέλων δυνάμεως αὐτοῦ","targetText":"and to grant relief to you who are oppressed and to us as well. This will take place when the Lord Jesus is revealed from heaven with His mighty angels","groups":[{"id":0,"source":[0,3],"target":[0,3]},{"id":4,"source":[26,32],"target":[4,19]},{"id":1,"source":[4,8],"target":[20,26]},{"id":2,"source":[9,13],"target":[27,30]},