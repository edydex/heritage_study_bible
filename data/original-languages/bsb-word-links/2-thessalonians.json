ood desire and work of faith,","groups":[{"id":0,"source":[0,3],"target":[0,11]},{"id":3,"source":[10,22],"target":[13,27]},{"id":5,"source":[31,35],"target":[28,31]},{"id":6,"source":[36,41],"target":[32,35]},{"id":7,"source":[42,45],"target":[37,41]},{"id":14,"source":[77,81],"target":[42,45]},{"id":13,"source":[72,76],"target":[46,49]},{"id":9,"source":[51,57],"target":[50,71]},{"id":10,"source":[58,61],"target":[72,78]},{"id":11,"source":[62,69],"target":[79,86]},{"id":15,"source":[82,85],"target":[88,96]},{"id":16,"source":[86,93],"target":[97,123]},{"id":17,"source":[94,99],"target":[124,134]},{"id":19,"source":[109,119],"target":[135,139]},{"id":18,"source":[100,108],"target":[140,146]},{"id":20,"source":[120,123],"target":[147,150]},{"id":21,"source":[124,129],"target":[151,155]},{"id":22,"source":[130,137],"target":[156,164]}]},"1:12":{"sourceText":"ὅπως ἐνδοξασθῇ τὸ ὄνομα τοῦ Κυρίου ἡμῶν Ἰησοῦ ἐν ὑμῖν, καὶ ὑμεῖς ἐν αὐτῷ, κατὰ τὴν χάριν τοῦ Θεοῦ ἡμῶν καὶ Κυρίου Ἰησοῦ Χριστοῦ.","targetText":"so that the name of our Lord Jesus will be glorified in you, and you in Him, according to the grace of our God and of the Lord Jesus Christ.","groups":[{"id":0,"source":[0,4],"target":[0,7]},{"id":2,"source":[15,17],"target":[8,11]},{"id":3,"source":[18,23],"target":[12,16]},{"id":6,"source":[35,39],"target":[17,23]},{"id":5,"source":[28,34],"target":[24,28]},{"id":7,"source":[40,45],"target":[29,34]},{"id":1,"source":[5,14],"target":[35,52]},{"id":8,"source":[46,48],"target":[53,55]},{"id":9,"source":[49,54],"target":[56,59]},{"id":10,"source":[55,58],"target":[61,64]},{"id":11,"source":[59,64],"target":[65,68]},{"id":12,"source":[65,67],"target":[69,71]},{"id":13,"source":[68,73],"target":[72,75]},{"id":14,"source":[74,78],"target":[77,89]},{"id":15,"source":[79,82],"target":[90,93]},{"id":16,"source":[83,88],"target":[94,99]},{"id":19,"source":[98,102],"target":[100,106]},{"id":18,"source":[93,97],"target":[107,110]},{"id":20,"source":[103,106],"target":[111,114]},{"id":21,"source":[107,113],"target":[115,126]},{"id":22,"source":[114,119],"target":[127,132]},{"id":23,"source":[120,128],"target":[133,139]}]},"2:1":{"sourceText":"Ἐρωτῶμεν δὲ ὑμᾶς, ἀδελφοί, ὑπὲρ τῆς παρουσίας τοῦ Κυρίου ἡμῶν Ἰησοῦ Χριστοῦ καὶ ἡμῶν ἐπισυναγωγῆς ἐπ’ αὐτόν,","targetText":"Now concerning the coming of our Lord Jesus Christ and our being gathered together to Him, we ask you, brothers,","groups":[{"id":1,"source":[9,11],"target":[0,3]},{"id":4,"source":[27,31],"target":[4,14]},{"id":5,"source":[32,35],"target":[15,18]},{"id":6,"source":[36,45],"target":[19,25]},{"id":9,"source":[57,61],"target":[26,32]},{"id":8,"source":[50,56],"target":[33,37]},{"id":10,"source":[62,67],"target":[38,43]},{"id":11,"source":[68,75],"target":[44,50]},{"id":12,"source":[76,79],"target":[51,54]},{"id":13,"source":[80,84],"target":[55,58]},{"id":14,"source":[85,97],"target":[59,82]},{"id":15,"source":[98,101],"target":[83,85]},{"id":16,"source":[102,108],"target":[86,89]},{"id":0,"source":[0,8],"target":[91,97]},{"id":2,"source":[12,17],"target":[98,101]},{"id":3,"source":[18,26],"target":[103,111]}]},"2:2":{"sourceText":"εἰς τὸ μὴ ταχέως σαλευθῆναι ὑμᾶς ἀπὸ τοῦ νοὸς μηδὲ θροεῖσθαι μήτε διὰ πνεύματος μήτε διὰ λόγου μήτε δι’ ἐπιστολῆς ὡς δι’ ἡμῶν, ὡς ὅτι ἐνέστηκεν ἡ ἡμέρα τοῦ Κυρίου.","targetText":"not to be easily disconcerted or alarmed by any spirit or message or letter seeming to be from us, alleging that the Day of the Lord has already come.","groups":[{"id":2,"source":[7,9],"target":[0,3]},{"id":4,"source":[17,27],"target":[4,29]},{"id":9,"source":[46,50],"target":[30,32]},{"id":10,"source":[51,60],"target":[33,40]},{"id":12,"source":[66,69],"target":[41,43]},{"id":13,"source":[70,79],"target":[44,54]},{"id":14,"source":[80,84],"target":[55,57]},{"id":16,"source":[89,94],"target":[58,65]},{"id":17,"source":[95,99],"target":[66,68]},{"id":19,"source":[104,113],"target":[69,75]},{"id":20,"source":[114,116],"target":[76,83]},{"id":21,"source":[117,120],"target":[84,94]},{"id":22,"source":[121,126],"target":[95,97]},{"id":23,"source":[127,129],"target":[99,107]},{"id":24,"source":[130,133],"target":[108,112]},{"id":26,"source":[144,145],"target":[113,116]},{"id":27,"source":[146,151],"target":[117,120]},{"id":28,"source":[152,155],"target":[121,127]},{"id":29,"source":[156,163],"target":[128,132]},{"id":25,"source":[134,143],"target":[133,149]}]},"2:3":{"sourceText":"μή τις ὑμᾶς ἐξαπατήσῃ κατὰ μηδένα τρόπον· ὅτι ἐὰν μὴ ἔλθῃ ἡ ἀποστασία πρῶτον καὶ ἀποκαλυφθῇ ὁ ἄνθρωπος τῆς ἀνομίας, ὁ υἱὸς τῆς ἀπωλείας,","targetText":"Let no one deceive you in any way, for it will not come until the rebellion occurs and the man of lawlessness—the son of destruction—is revealed.","groups":[{"id":0,"source":[0,2],"target":[0,6]},{"id":1,"source":[3,6],"target":[7,10]},{"id":3,"source":[12,21],"target":[11,18]},{"id":2,"source":[7,11],"target":[19,22]},{"id":4,"source":[22,26],"target":[23,25]},{"id":5,"source":[27,33],"target":[26,29]},{"id":6,"source":[34,41],"target":[30,33]},{"id":7,"source":[42,45],"target":[35,55]},{"id":8,"source":[46,49],"target":[56,61]},{"id":11,"source":[58,59],"target":[62,65]},{"id":12,"source":[60,69],"target":[66,75]},{"id":10,"source":[53,57],"target":[76,82]},{"id":14,"source":[77,80],"target":[83,86]},{"id":16,"source":[92,93],"target":[87,90]},{"id":17,"source":[94,102],"target":[91,94]},{"id":19,"source":[107,115],"target":[95,109]},{"id":20,"source":[116,117],"target":[110,113]},{"id":21,"source":[118,122],"target":[114,117]},{"id":23,"source":[127,136],"target":[118,132]},{"id":15,"source":[81,91],"target":[133,144]}]},"2:4":{"sourceText":"ὁ ἀντικείμενος καὶ ὑπεραιρόμενος ἐπὶ πάντα λεγόμενον Θεὸν ἢ σέβασμα, ὥστε αὐτὸν εἰς τὸν ναὸν τοῦ Θεοῦ καθίσαι, ἀποδεικνύντα ἑαυτὸν ὅτι ἔστιν Θεός.","targetText":"He will oppose and exalt himself above every so-called god or object of worship. So he will seat himself in the temple of God, proclaiming himself to be God.","groups":[{"id":0,"source":[0,1],"target":[0,2]},{"id":1,"source"