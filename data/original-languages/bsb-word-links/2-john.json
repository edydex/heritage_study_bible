"source":[129,138],"target":[117,122]}]},"1:2":{"sourceText":"διὰ τὴν ἀλήθειαν τὴν μένουσαν ἐν ἡμῖν, καὶ μεθ’ ἡμῶν ἔσται εἰς τὸν αἰῶνα.","targetText":"because of the truth that abides in us and will be with us forever:","groups":[{"id":0,"source":[0,3],"target":[0,10]},{"id":1,"source":[4,7],"target":[11,14]},{"id":2,"source":[8,16],"target":[15,20]},{"id":3,"source":[17,20],"target":[21,25]},{"id":4,"source":[21,29],"target":[26,32]},{"id":5,"source":[30,32],"target":[33,35]},{"id":6,"source":[33,38],"target":[36,38]},{"id":7,"source":[39,42],"target":[39,42]},{"id":10,"source":[53,58],"target":[43,50]},{"id":8,"source":[43,47],"target":[51,55]},{"id":9,"source":[48,52],"target":[56,58]},{"id":13,"source":[67,73],"target":[59,66]}]},"1:3":{"sourceText":"ἔσται μεθ’ ἡμῶν χάρις ἔλεος εἰρήνη παρὰ Θεοῦ Πατρός, καὶ παρὰ Ἰησοῦ Χριστοῦ τοῦ Υἱοῦ τοῦ Πατρός, ἐν ἀληθείᾳ καὶ ἀγάπῃ.","targetText":"Grace, mercy, and peace from God the Father and from Jesus Christ, the Son of the Father, will be with us in truth and love.","groups":[{"id":3,"source":[16,21],"target":[0,5]},{"id":4,"source":[22,27],"target":[7,12]},{"id":5,"source":[28,34],"target":[14,23]},{"id":6,"source":[35,39],"target":[24,28]},{"id":7,"source":[40,44],"target":[29,32]},{"id":8,"source":[45,52],"target":[33,43]},{"id":9,"source":[53,56],"target":[44,47]},{"id":10,"source":[57,61],"target":[48,52]},{"id":11,"source":[62,67],"target":[53,58]},{"id":12,"source":[68,75],"target":[59,65]},{"id":13,"source":[76,79],"target":[67,70]},{"id":14,"source":[80,84],"target":[71,74]},{"id":15,"source":[85,88],"target":[75,81]},{"id":16,"source":[89,96],"target":[82,88]},{"id":0,"source":[0,5],"target":[90,97]},{"id":1,"source":[6,10],"target":[98,102]},{"id":2,"source":[11,15],"target":[103,105]},{"id":17,"source":[97,99],"target":[106,108]},{"id":18,"source":[100,107],"target":[109,114]},{"id":19,"source":[108,111],"target":[115,118]},{"id":20,"source":[112,118],"target":[119,123]}]},"1:4":{"sourceText":"Ἐχάρην λίαν ὅτι εὕρηκα ἐκ τῶν τέκνων σου περιπατοῦντας ἐν ἀληθείᾳ, καθὼς ἐντολὴν ἐλάβομεν παρὰ τοῦ Πατρός.","targetText":"I was overjoyed to find some of your children walking in the truth, just as the Father has commanded us.","groups":[{"id":0,"source":[0,6],"target":[0,15]},{"id":2,"source":[12,15],"target":[16,18]},{"id":3,"source":[16,22],"target":[19,23]},{"id":4,"source":[23,25],"target":[24,31]},{"id":7,"source":[37,40],"target":[32,36]},{"id":6,"source":[30,36],"target":[37,45]},{"id":8,"source":[41,54],"target":[46,53]},{"id":9,"source":[55,57],"target":[54,56]},{"id":10,"source":[58,66],"target":[57,66]},{"id":11,"source":[67,72],"target":[68,75]},{"id":15,"source":[95,98],"target":[76,79]},{"id":16,"source":[99,106],"target":[80,86]},{"id":12,"source":[73,80],"target":[87,100]},{"id":13,"source":[81,89],"target":[101,103]}]},"1:6":{"sourceText":"καὶ αὕτη ἐστὶν ἡ ἀγάπη, ἵνα περιπατῶμεν κατὰ τὰς ἐντολὰς αὐτοῦ· αὕτη ἡ ἐντολή ἐστιν, καθὼς ἠκούσατε ἀπ’ ἀρχῆς, ἵνα ἐν αὐτῇ περιπατῆτε.","targetText":"And this is love, that we walk according to His commandments. This is the very commandment you have heard from the beginning, that you must walk in love.","groups":[{"id":0,"source":[0,3],"target":[0,3]},{"id":1,"source":[4,8],"target":[4,8]},{"id":2,"source":[9,14],"target":[9,11]},{"id":4,"source":[17,23],"target":[12,16]},{"id":5,"source":[24,27],"target":[18,22]},{"id":6,"source":[28,39],"target":[23,30]},{"id":7,"source":[40,44],"target":[31,43]},{"id":10,"source":[57,63],"target":[44,47]},{"id":9,"source":[49,56],"target":[48,60]},{"id":11,"source":[64,68],"target":[62,66]},{"id":14,"source":[78,84],"target":[67,69]},{"id":12,"source":[69,70],"target":[70,73]},{"id":15,"source":[85,90],"target":[74,78]},{"id":13,"source":[71,77],"target":[79,90]},{"id":16,"source":[91,99],"target":[91,105]},{"id":17,"source":[100,103],"target":[106,110]},{"id":18,"source":[104,110],"target":[111,124]},{"id":19,"source":[111,114],"target":[126,130]},{"id":22,"source":[123,134],"target":[131,144]},{"id":20,"source":[115,117],"target":[145,147]},{"id":21,"source":[118,122],"target":[148,152]}]},"1:7":{"sourceText":"ὅτι πολλοὶ πλάνοι ἐξῆλθον εἰς τὸν κόσμον, οἱ μὴ ὁμολογοῦντες Ἰησοῦν Χριστὸν ἐρχόμενον ἐν σαρκί· οὗτός ἐστιν ὁ πλάνος καὶ ὁ ἀντίχριστος.","targetText":"For many deceivers have gone out into the world, refusing to confess the coming of Jesus Christ in the flesh. Any such person is the deceiver and the antichrist.","groups":[{"id":0,"source":[0,3],"target":[0,3]},{"id":1,"source":[4,10],"target":[4,8]},{"id":2,"source":[11,17],"target":[9,18]},{"id":3,"source":[18,25],"target":[19,32]},{"id":4,"source":[26,29],"target":[33,37]},{"id":5,"source":[30,33],"target":[38,41]},{"id":6,"source":[34,41],"target":[42,47]},{"id":8,"source":[45,47],"target":[49,57]},{"id":9,"source":[48,60],"target":[58,68]},{"id":12,"source":[76,85],"target":[69,82]},{"id":10,"source":[61,67],"target":[83,88]},{"id":11,"source":[68,75],"target":[89,95]},{"id":13,"source":[86,88],"target":[96,98]},{"id":14,"source":[89,95],"target":[99,108]},{"id":15,"source":[96,101],"target":[110,125]},{"id":16,"source":[102,107],"target":[126,128]},{"id":17,"source":[108,109],"target":[129,132]},{"id":18,"source":[110,116],"target":[133,141]},{"id":19,"source":[117,120],"target":[142,145]},{"id":20,"source":[121,122],"target":[146,149]},{"id":21,"source":[123,135],"target":[150,160]}]},"1:9":{"sourceText":"πᾶς ὁ προάγων καὶ μὴ μένων ἐν τῇ διδαχῇ τοῦ Χριστοῦ Θεὸν οὐκ ἔχει· ὁ μένων ἐν τῇ διδαχῇ, οὗτος καὶ τὸν Πατέρα καὶ τὸν Υἱὸν ἔχει.","targetText":"Anyone who runs ahead without remaining in the teaching of Christ does not have God. Whoever remains in His teaching has both the Father and the Son.","groups":[{"id":0,"source":[0,3],"target":[0,6]},{"id":1,"source":[4,5],"target":[7,10]},{"id":2,"source":[6,13],"target":[11,21]},{"id":4,"source":[18,20],"target":[22,29]},{"id":5,"source":[21,26],"target":[30,39]},{"id":6,"source":[27,29],"target":[40,42]},{"id":7,"source":[30,32],"target":[43,46]},{"id":8,"source":[33,39],"target":[47,55]},{"id":10,"source":[44,51],"target":[56,65]},{"id":13,"source":[61,66],"target":[66,79]},{"id":11,"source":[52,56],"target":[80,83]},{"id":14,"source":[67,68],"target":[85,92]},{"id":15,"source":[69,74],"target":[93,100]},{"id":16,"source":[75,77],"target":[101,103]},{"id":17,"source":[78,80],"target":[104,107]},{"id":18,"source":[81,88],"target":[108,116]},{"id":26,"source":[123,128],"target":[117,120]},{"id":20,"source":[95,98],"target":[121,125]},{"id":21,"source":[99,102],"target":[126,129]},{"id":22,"source":[103,109],"target":[130,136]},{"id":23,"source":[110,113],"target":[137,140]},{"id":24,"source":[114,117],"target":[141,144]},{"id":25,"source":[118,122],"target":[145,148]}]},"1:10":{"sourceText":"εἴ τις ἔρχεται πρὸς ὑμᾶς καὶ ταύτην τὴν διδαχὴν οὐ φέρει, μὴ λαμβάνετε αὐτὸν εἰς οἰκίαν, καὶ χαίρειν αὐτῷ μὴ λέγετε·","targetText":"If anyone comes to you but does not bring this teaching, do not receive him into your home or even greet him.","groups":[{"id":0,"source":[0,2],"target":[0,2]},{"id":1,"source":[3,6],"target":[3,9]},{"id":2,"source":[7,14],"target":[10,15]},{"id":3,"source":[15,19],"target":[16,18]},{"id":4,"source":[20,24],"target":[19,22]},{"id":5,"source":[25,28],"target":[23,26]},{"id":10,"source":[51,57],"target":[27,41]},{"id":6,"source":[29,35],"target":[42,46]},{"id":8,"source":[40,47],"target":[47,55]},{"id":11,"source":[58,60],"target":[57,63]},{"id":12,"source":[61,70],"target":[64,71]},{"id":13,"source":[71,76],"target":[72,75]},{"id":14,"source":[77,80],"target":[76,80]},{"id":15,"source":[81,88],"target":[81,90]},{"id":19,"source":[106,108],"target":[91,93]},{"id":16,"source":[89,92],"target":[94,98]},{"id":20,"source":[109,116],"target":[99,104]},{"id":18,"source":[101,105],"target":[105,108]}]},"1:11":{"sourceText":"ὁ λέγων γὰρ αὐτῷ χαίρειν κοινωνεῖ τοῖς ἔργοις αὐτοῦ τοῖς πονηροῖς.","targetText":"Whoever greets such a person shares in his evil deeds.","groups":[{"id":0,"source":[0,1],"target":[0,7]},{"id":1,"source":[2,7],"target":[8,14]},{"id":3,"source":[12,16],"target":[15,28]},{"id":5,"source":[25,33],"target":[29,35]},{"id":6,"source":[34,38],"target":[36,38]},{"id":8,"source":[46,51],"target":[39,42]},{"id":10,"source":[57,66],"target":[43,47]},{"id":7,"source":[39,45],"target":[48,53]}]},"1:12":{"sourceText":"Πολλὰ ἔχων ὑμῖν γράφειν οὐκ ἐβουλήθην διὰ χάρτου καὶ μέλανος, ἀλλὰ ἐλπίζω γενέσθαι πρὸς ὑμᾶς καὶ στόμα πρὸς στόμα λαλῆσαι, ἵνα ἡ χαρὰ ἡμῶν πεπληρωμένη ᾖ.","targetText":"I have many things to write to you, but I would prefer not to do so with paper and ink. Instead, I hope to come and speak with you face to face, so that our joy may be complete.","groups":[{"id":1,"source":[6,10],"target":[0,6]},{"id":0,"source":[0,5],"target":[7,18]},{"id":3,"source":[16,23],"target":[19,27]},{"id":2,"source":[11,15],"target":[28,34]},{"id":5,"source":[28,37],"target":[36,54]},{"id":4,"source":[24,27],"target":[55,67]},{"id":6,"source":[38,41],"target":[68,72]},{"id":7,"source":[42,48],"target":[73,78]},{"id":8,"source":[49,52],"target":[79,82]},{"id":9,"source":[53,61],"target":[83,86]},{"id":10,"source":[62,66],"target":[88,95]},{"id":11,"source":[67,73],"target":[97,103]},{"id":12,"source":[74,82],"target":[104,111]},{"id":15,"source":[93,96],"target":[112,115]},{"id":19,"source":[114,122],"target":[116,121]},{"id":13,"source":[83,87],"target":[122,126]},{"id":14,"source":[88,92],"target":[127,130]},{"id":16,"source":[97,102],"target":[131,135]},{"id":17,"source":[103,107],"target":[136,138]},{"id":18,"source":[108,113],"target":[139,143]},{"id":20,"source":[123,126],"target":[145,152]},{"id":23,"source":[134,138],"target":[153,156]},{"id":22,"source":[129,133],"target":[157,160]},{"id":25,"source":[151,153],"target":[161,167]},{"id":24,"source":[139,150],"target":[168,176]}]},"1:13":{"sourceText":"Ἀσπάζεταί σε τὰ τέκνα τῆς ἀδελφῆς σου τῆς ἐκλεκτῆς.","targetText":"The children of your elect sister send you greetings.","groups":[{"id":2,"source":[13,15],"target":[0,3]},{"id":3,"source":[16,21],"target":[4,12]},{"id":6,"source":[34,37],"target":[13,20]},{"id":8,"source":[42,51],"target":[21,26]},{"id":5,"source":[26,33],"target":[27,33]},{"id":0,"source":[0,9],"target":[34,52]}]}},"unavailable":{"1:5":"greek-edition-differs","1:8":"greek-edition-differs"}}
