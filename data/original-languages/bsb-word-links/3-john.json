{"schemaVersion":1,"book":"3 John","sourceId":"N1904","targetId":"BSB","provenance":{"url":"https://bereanbible.com/bsb_tables.tsv","license":"CC0","licenseUrl":"https://berean.bible/terms.htm","tableSha256":"09bbee6f9fe4fa22b5df28e8a9ffa99bf9c33435f4eb8c47c2dc221d855d35cb","targetSha256":"8afd83b240d4ac4168127d4d039896a2245883d431e9125899b6adcbd5b32285","greekSha256":"3beee6abb6302f691110fe0fc949fc195593b999cf2d0e463c9b573c1bb67150"},"method":"Publisher row links transferred only when the whole Greek and English verse word sequences agree; Greek comparison ignores accents, case and punctuation. English comparison ignores case and punctuation. No inferred synonym or Strong-number matching.","verses":{"1:1":{"sourceText":"Ὁ πρεσβύτερος Γαΐῳ τῷ ἀγαπητῷ, ὃν ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ.","targetText":"The elder,  To the beloved Gaius, whom I love in the truth:","groups":[{"id":0,"source":[0,1],"target":[0,3]},{"id":1,"source":[2,13],"target":[4,9]},{"id":3,"source":[19,21],"target":[12,18]},{"id":4,"source":[22,30],"target":[19,26]},{"id":2,"source":[14,18],"target":[27,32]},{"id":5,"source":[31,33],"target":[34,38]},{"id":6,"source":[34,37],"target":[39,40]},{"id":7,"source":[38,43],"target":[41,45]},{"id":8,"source":[44,46],"target":[46,48]},{"id":9,"source":[47,55],"target":[49,58]}]},"1:2":{"sourceText":"Ἀγαπητέ, περὶ πάντων εὔχομαί σε εὐοδοῦσθαι καὶ ὑγιαίνειν, καθὼς εὐοδοῦταί σου ἡ ψυχή.","targetText":"Beloved, I pray that in every way you may prosper and enjoy good health, as your soul also prospers.","groups":[{"id":0,"source":[0,8],"target":[0,7]},{"id":3,"source":[21,28],"target":[9,20]},{"id":1,"source":[9,13],"target":[21,23]},{"id":2,"source":[14,20],"target":[24,33]},{"id":4,"source":[29,31],"target":[34,37]},{"id":5,"source":[32,42],"target":[38,49]},{"id":6,"source":[43,46],"target":[50,53]},{"id":7,"source":[47,57],"target":[54,71]},{"id":8,"source":[58,63],"target":[73,75]},{"id":10,"source":[74,77],"target":[76,80]},{"id":12,"source":[80,85],"target":[81,90]},{"id":9,"source":[64,73],"target":[91,99]}]},"1:3":{"sourceText":"ἐχάρην γὰρ λίαν ἐρχομένων ἀδελφῶν καὶ μαρτυρούντων σου τῇ ἀληθείᾳ, καθὼς σὺ ἐν ἀληθείᾳ περιπατεῖς.","targetText":"For I was overjoyed when the brothers came and testified about your devotion to the truth, in which you continue to walk.","groups":[{"id":1,"source":[7,10],"target":[0,3]},{"id":0,"source":[0,6],"target":[4,19]},{"id":4,"source":[26,33],"target":[20,37]},{"id":3,"source":[16,25],"target":[38,42]},{"id":5,"source":[34,37],"target":[43,46]},{"id":6,"source":[38,50],"target":[47,56]},{"id":7,"source":[51,54],"target":[57,67]},{"id":9,"source":[58,66],"target":[68,89]},{"id":12,"source":[76,78],"target":[91,93]},{"id":13,"source":[79,86],"target":[94,99]},{"id":11,"source":[73,75],"target":[100,103]},{"id":14,"source":[87,98],"target":[104,120]}]},"1:4":{"sourceText":"μειζοτέραν τούτων οὐκ ἔχω χαράν, ἵνα ἀκούω τὰ ἐμὰ τέκνα ἐν τῇ ἀληθείᾳ περιπατοῦντα.","targetText":"I have no greater joy than to hear that my children are walking in the truth.","groups":[{"id":3,"source":[22,25],"target":[0,6]},{"id":2,"source":[18,21],"target":[7,9]},{"id":0,"source":[0,10],"target":[10,17]},{"id":4,"source":[26,32],"target":[18,21]},{"id":1,"source":[11,17],"target":[22,26]},{"id":5,"source":[33,36],"target":[27,29]},{"id":6,"source":[37,42],"target":[30,39]},{"id":8,"source":[46,49],"target":[40,42]},{"id":9,"source":[50,55],"target":[43,51]},{"id":13,"source":[70,83],"target":[52,63]},{"id":10,"source":[56,58],"target":[64,66]},{"id":11,"source":[59,61],"target":[67,70]},{"id":12,"source":[62,69],"target":[71,76]}]},"1:5":{"sourceText":"Ἀγαπητέ, πιστὸν ποιεῖς ὃ ἐὰν ἐργάσῃ εἰς τοὺς ἀδελφοὺς καὶ τοῦτο ξένους,","targetText":"Beloved, you are faithful in what you are doing for the brothers, and especially since they are strangers to you.","groups":[{"id":0,"source":[0,8],"target":[0,7]},{"id":2,"source":[16,22],"target":[9,16]},{"id":1,"source":[9,15],"target":[17,25]},{"id":3,"source":[23,24],"target":[26,33]},{"id":5,"source":[29,35],"target":[34,47]},{"id":6,"source":[36,39],"target":[48,51]},{"id":7,"source":[40,44],"target":[52,55]},{"id":8,"source":[45,53],"target":[56,64]},{"id":9,"source":[54,57],"target":[66,86]},{"id":10,"source":[58,63],"target":[87,95]},{"id":11,"source":[64,71],"target":[96,112]}]},"1:6":{"sourceText":"οἳ ἐμαρτύρησάν σου τῇ ἀγάπῃ ἐνώπιον ἐκκλησίας, οὓς καλῶς ποιήσεις προπέμψας ἀξίως τοῦ Θεοῦ·","targetText":"They have testified to the church about your love. You will do well to send them on their way in a manner worthy of God.","groups":[{"id":0,"source":[0,2],"target":[0,4]},{"id":1,"source":[3,14],"target":[5,19]},{"id":5,"source":[28,35],"target":[20,22]},{"id":6,"source":[36,46],"target":[23,33]},{"id":2,"source":[15,18],"target":[34,44]},{"id":4,"source":[22,27],"target":[45,49]},{"id":9,"source":[57,65],"target":[51,62]},{"id":8,"source":[51,56],"target":[63,67]},{"id":10,"source":[66,75],"target":[68,93]},{"id":11,"source":[76,81],"target":[94,112]},{"id":13,"source":[86,91],"target":[113,119]}]},"1:8":{"sourceText":"ἡμεῖς οὖν ὀφείλομεν ὑπολαμβάνειν τοὺς τοιούτους, ἵνα συνεργοὶ γινώμεθα τῇ ἀληθείᾳ.","targetText":"Therefore we ought to support such men, so that we may be fellow workers for the truth.","groups":[{"id":1,"source":[6,9],"target":[0,9]},{"id":0,"source":[0,5],"target":[10,12]},{"id":2,"source":[10,19],"target":[13,18]},{"id":3,"source":[20,32],"target":[19,29]},{"id":5,"source":[38,48],"target":[30,38]},{"id":6,"source":[49,52],"target":[40,47]},{"id":8,"source":[62,70],"target":[48,57]},{"id":7,"source":[53,61],"target":[58,72]},{"id":9,"source":[71,73],"target":[73,80]},{"id":10,"source":[74,82],"target":[81,86]}]},"1:9":{"sourceText":"Ἔγραψά τι τῇ ἐκκλησίᾳ· ἀλλ’ ὁ φιλοπρωτεύων αὐτῶν Διοτρεφὴς οὐκ ἐπιδέχεται ἡμᾶς.","targetText":"I have written to the church about this, but Diotrephes, who loves to be first, will not accept our instruction.","groups":[{"id":0,"source":[0,6],"target":[0,14]},{"id":2,"source":[10,12],"target":[15,21]},{"id":3,"source":[13,22],"target":[22,28]},{"id":1,"source":[7,9],"target":[29,39]},{"id":4,"source":[23,27],"target":[41,44]},{"id":8,"source":[49,58],"target":[45,55]},{"id":5,"source":[28,29],"target":[57,60]},{"id":6,"source":[30,42],"target":[61,78]},{"id":10,"source":[63,73],"target":[80,95]},{"id":11,"source":[74,79],"target":[96,111]}]},"1:10":{"sourceText":"διὰ τοῦτο, ἐὰν ἔλθω, ὑπομνήσω αὐτοῦ τὰ ἔργα ἃ ποιεῖ λόγοις πονηροῖς φλυαρῶν ἡμᾶς, καὶ μὴ ἀρκούμενος ἐπὶ τούτοις οὔτε αὐτὸς ἐπιδέχεται τοὺς ἀδελφοὺς καὶ τοὺς βουλομένους κωλύει καὶ ἐκ τῆς ἐκκλησίας ἐκβάλλει.","targetText":"So if I come, I will call attention to his malicious slander against us. And unsatisfied with that, he refuses to welcome the brothers and forbids those who want to do so, even putting them out of the church.","groups":[{"id":0,"source":[0,3],"target":[0,2]},{"id":2,"source":[11,14],"target":[3,5]},{"id":3,"source":[15,20],"target":[6,12]},{"id":4,"source":[21,29],"target":[14,38]},{"id":8,"source":[44,45],"target":[39,42]},{"id":11,"source":[59,67],"target":[43,52]},{"id":12,"source":[68,75],"target":[53,60]},{"id":13,"source":[76,81],"target":[61,71]},{"id":14,"source":[82,85],"target":[73,76]},{"id":16,"source":[89,99],"target":[77,88]},{"id":17,"source":[100,103],"target":[89,93]},{"id":18,"source":[104,111],"target":[94,98]},{"id":21,"source":[123,133],"target":[100,121]},{"id":22,"source":[134,138],"target":[122,125]},{"id":23,"source":[139,147],"target":[126,134]},{"id":24,"source":[148,151],"target":[135,138]},{"id":27,"source":[169,175],"target":[139,146]},{"id":25,"source":[152,156],"target":[147,156]},{"id":26,"source":[157,168],"target":[157,170]},{"id":28,"source":[176,179],"target":[172,176]},{"id":32,"source":[197,206],"target":[177,189]},{"id":29,"source":[180,182],"target":[190,196]},{"id":30,"source":[183,186],"target":[197,200]},{"id":31,"source":[187,196],"target":[201,207]}]},"1:11":{"sourceText":"Ἀγαπητέ, μὴ μιμοῦ τὸ κακὸν ἀλλὰ τὸ ἀγαθόν. ὁ ἀγαθοποιῶν ἐκ τοῦ Θεοῦ ἐστιν· ὁ κακοποιῶν οὐχ ἑώρακεν τὸν Θεόν.","targetText":"Beloved, do not imitate what is evil, but what is good. The one who does good is of God; the one who does evil has not seen God.","groups":[{"id":0,"source":[0,8],"target":[0,7]},{"id":1,"source":[9,11],"target":[9,15]},{"id":2,"source":[12,17],"target":[16,23]},{"id":3,"source":[18,20],"target":[24,31]},{"id":4,"source":[21,26],"target":[32,36]},{"id":5,"source":[27,31],"target":[38,41]},{"id":6,"source":[32,34],"target":[42,49]},{"id":7,"source":[35,42],"target":[50,54]},{"id":8,"source":[43,44],"target":[56,67]},{"id":9,"source":[45,55],"target":[68,77]},{"id":13,"source":[68,74],"target":[78,80]},{"id":10,"source":[56,58],"target":[81,83]},{"id":12,"source":[63,67],"target":[84,87]},{"id":14,"source":[75,76],"target":[89,100]},{"id":15,"source":[77,86],"target":[101,110]},{"id":17,"source":[91,98],"target":[111,123]},{"id":19,"source":[103,108],"target":[124,127]}]},"1:12":{"sourceText":"Δημητρίῳ μεμαρτύρηται ὑπὸ πάντων καὶ ὑπὸ αὐτῆς τῆς ἀληθείας· καὶ ἡμεῖς δὲ μαρτυροῦμεν, καὶ οἶδας ὅτι ἡ μαρτυρία ἡμῶν ἀληθής ἐστιν.","targetText":"Demetrius has received a good testimony from everyone, and from the truth itself. We also testify for him, and you know that our testimony is true.","groups":[{"id":0,"source":[0,8],"target":[0,9]},{"id":1,"source":[9,21],"target":[10,39]},{"id":2,"source":[22,25],"target":[40,44]},{"id":3,"source":[26,32],"target":[45,53]},{"id":4,"source":[33,36],"target":[55,58]},{"id":5,"source":[37,40],"target":[59,63]},{"id":7,"source":[47,50],"target":[64,67]},{"id":8,"source":[51,60],"target":[68,73]},{"id":6,"source":[41,46],"target":[74,80]},{"id":10,"source":[65,70],"target":[82,84]},{"id":11,"source":[71,73],"target":[85,89]},{"id":12,"source":[74,86],"target":[90,105]},{"id":13,"source":[87,90],"target":[107,110]},{"id":14,"source":[91,96],"target":[111,119]},{"id":15,"source":[97,100],"target":[120,124]},{"id":18,"source":[112,116],"target":[125,128]},{"id":17,"source":[103,111],"target":[129,138]},{"id":20,"source":[124,130],"target":[139,141]},{"id":19,"source":[117,123],"target":[142,146]}]},"1:13":{"sourceText":"Πολλὰ εἶχον γράψαι σοι, ἀλλ’ οὐ θέλω διὰ μέλανος καὶ καλάμου σοι γράφειν·","targetText":"I have many things to write to you, but I would prefer not to do so with pen and ink.","groups":[{"id":1,"source":[6,11],"target":[0,6]},{"id":0,"source":[0,5],"target":[7,18]},{"id":2,"source":[12,18],"target":[19,27]},{"id":3,"source":[19,23],"target":[28,34]},{"id":4,"source":[24,28],"target":[36,39]},{"id":6,"source":[32,36],"target":[40,54]},{"id":5,"source":[29,31],"target":[55,58]},{"id":12,"source":[65,73],"target":[59,67]},{"id":7,"source":[37,40],"target":[68,72]},{"id":10,"source":[53,60],"target":[73,76]},{"id":9,"source":[49,52],"target":[77,80]},{"id":8,"source":[41,48],"target":[81,84]}]}},"unavailable":{"1:7":"greek-edition-differs","1:14":"greek-edition-differs","1:15":"greek-edition-differs"}}
