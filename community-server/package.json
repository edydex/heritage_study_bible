{
  "name": "heritage-community-server",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted church community and content server for Heritage Study Bible",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test:deploy": "bash deploy/tests/run.sh",
    "test:appliance": "bash appliance/tests/run.sh",
    "test:syncshow": "node --import tsx --test tests/syncshow-protocol.test.ts tests/syncshow-endpoint.test.ts tests/syncshow-backfill.test.ts && node --test tests/syncshow-contract.test.mjs",
    "preflight:syncshow": "node --import tsx scripts/syncshow-backfill-report.mjs",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-nodemailer": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.2.10",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.24",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.10"
  }
}
