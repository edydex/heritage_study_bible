espise you.","groups":[{"id":1,"source":[6,11],"target":[0,5]},{"id":0,"source":[0,5],"target":[6,18]},{"id":2,"source":[12,15],"target":[19,21]},{"id":3,"source":[16,25],"target":[22,35]},{"id":4,"source":[26,29],"target":[36,39]},{"id":5,"source":[30,36],"target":[40,46]},{"id":6,"source":[37,41],"target":[47,51]},{"id":7,"source":[42,47],"target":[52,55]},{"id":8,"source":[48,57],"target":[56,65]},{"id":9,"source":[58,64],"target":[67,77]},{"id":11,"source":[69,82],"target":[78,85]},{"id":10,"source":[65,68],"target":[86,89]}]},"3:1":{"sourceText":"Ὑπομίμνῃσκε αὐτοὺς ἀρχαῖς ἐξουσίαις ὑποτάσσεσθαι, πειθαρχεῖν, πρὸς πᾶν ἔργον ἀγαθὸν ἑτοίμους εἶναι,","targetText":"Remind the believers to submit to rulers and authorities, to be obedient and ready for every good work,","groups":[{"id":0,"source":[0,11],"target":[0,6]},{"id":1,"source":[12,18],"target":[7,20]},{"id":4,"source":[36,49],"target":[21,30]},{"id":2,"source":[19,25],"target":[31,40]},{"id":3,"source":[26,35],"target":[41,56]},{"id":5,"source":[50,61],"target":[58,72]},{"id":11,"source":[93,99],"target":[73,76]},{"id":10,"source":[84,92],"target":[77,82]},{"id":6,"source":[62,66],"target":[83,86]},{"id":7,"source":[67,70],"target":[87,92]},{"id":9,"source":[77,83],"target":[93,97]},{"id":8,"source":[71,76],"target":[98,102]}]},"3:2":{"sourceText":"μηδένα βλασφημεῖν, ἀμάχους εἶναι, ἐπιεικεῖς, πᾶσαν ἐνδεικνυμένους πραΰτητα πρὸς πάντας ἀνθρώπους.","targetText":"to malign no one, and to be peaceable and gentle, showing full consideration to everyone.","groups":[{"id":1,"source":[7,18],"target":[0,9]},{"id":0,"source":[0,6],"target":[10,16]},{"id":3,"source":[27,33],"target":[18,27]},{"id":2,"source":[19,26],"target":[28,37]},{"id":4,"source":[34,44],"target":[38,48]},{"id":6,"source":[51,65],"target":[50,57]},{"id":5,"source":[45,50],"target":[58,62]},{"id":7,"source":[66,74],"target":[63,76]},{"id":8,"source":[75,79],"target":[77,79]},{"id":9,"source":[80,86],"target":[80,88]}]},"3:3":{"sourceText":"Ἦμεν γάρ ποτε καὶ ἡμεῖς ἀνόητοι, ἀπειθεῖς, πλανώμενοι, δουλεύοντες ἐπιθυμίαις καὶ ἡδοναῖς ποικίλαις, ἐν κακίᾳ καὶ φθόνῳ διάγοντες, στυγητοί, μισοῦντες ἀλλήλους.","targetText":"For at one time we too were foolish, disobedient, misled, and enslaved to all sorts of desires and pleasures—living in malice and envy, being hated and hating one another.","groups":[{"id":1,"source":[5,8],"target":[0,3]},{"id":2,"source":[9,13],"target":[4,15]},{"id":4,"source":[18,23],"target":[16,18]},{"id":3,"source":[14,17],"target":[19,22]},{"id":0,"source":[0,4],"target":[23,27]},{"id":5,"source":[24,32],"target":[28,35]},{"id":6,"source":[33,42],"target":[37,48]},{"id":7,"source":[43,54],"target":[50,56]},{"id":8,"source":[55,66],"target":[58,70]},{"id":12,"source":[90,100],"target":[71,83]},{"id":9,"source":[67,77],"target":[84,94]},{"id":10,"source":[78,81],"target":[95,98]},{"id":11,"source":[82,89],"target":[99,108]},{"id":17,"source":[120,130],"target":[109,115]},{"id":13,"source":[101,103],"target":[116,118]},{"id":14,"source":[104,109],"target":[119,125]},{"id":15,"source":[110,113],"target":[126,129]},{"id":16,"source":[114,119],"target":[130,134]},{"id":18,"source":[131,140],"target":[136,147]},{"id":19,"source":[141,150],"target":[148,158]},{"id":20,"source":[151,160],"target":[159,170]}]},"3:4":{"sourceText":"ὅτε δὲ ἡ χρηστότης καὶ ἡ φιλανθρωπία ἐπεφάνη τοῦ Σωτῆρος ἡμῶν Θεοῦ,","targetText":"But when the kindness of God our Savior and His love for mankind appeared,","groups":[{"id":1,"source":[4,6],"target":[0,3]},{"id":0,"source":[0,3],"target":[4,8]},{"id":2,"source":[7,8],"target":[9,12]},{"id":3,"source":[9,18],"target":[13,21]},{"id":8,"source":[45,48],"target":[22,24]},{"id":11,"source":[62,67],"target":[25,28]},{"id":10,"source":[57,61],"target":[29,32]},{"id":9,"source":[49,56],"target":[33,39]},{"id":4,"source":[19,22],"target":[40,43]},{"id":5,"source":[23,24],"target":[44,47]},{"id":6,"source":[25,36],"target":[48,64]},{"id":7,"source":[37,44],"target":[65,73]}]},"3:5":{"sourceText":"οὐκ ἐξ ἔργων τῶν ἐν δικαιοσύνῃ ἃ ἐποιήσαμεν ἡμεῖς ἀλλὰ κατὰ τὸ αὐτοῦ ἔλεος ἔσωσεν ἡμᾶς διὰ λουτροῦ παλινγενεσίας καὶ ἀνακαινώσεως Πνεύματος Ἁγίου,","targetText":"He saved us, not by the righteous deeds we had done, but according to His mercy, through the washing of new birth and renewal by the Holy Spirit.","groups":[{"id":14,"source":[75,81],"target":[0,8]},{"id":15,"source":[82,86],"target":[9,11]},{"id":0,"source":[0,3],"target":[13,16]},{"id":1,"source":[4,6],"target":[17,19]},{"id":5,"source":[20,30],"target":[20,33]},{"id":2,"source":[7,12],"target":[34,39]},{"id":8,"source":[44,49],"target":[40,42]},{"id":7,"source":[33,43],"target":[43,51]},{"id":9,"source":[50,54],"target":[53,56]},{"id":10,"source":[55,59],"target":[57,69]},{"id":12,"source":[63,68],"target":[70,73]},{"id":13,"source":[69,74],"target":[74,79]},{"id":16,"source":[87,90],"target":[81,88]},{"id":17,"source":[91,98],"target":[89,100]},{"id":18,"source":[99,112],"target":[101,113]},{"id":19,"source":[113,116],"target":[114,117]},{"id":20,"source":[117,129],"target":[118,125]},{"id":22,"source":[140,146],"target":[126,137]},{"id":21,"source":[130,139],"target":[138,144]}]},"3:6":{"sourceText":"οὗ ἐξέχεεν ἐφ’ ἡμᾶς πλουσίως διὰ Ἰησοῦ Χριστοῦ τοῦ Σωτῆρος ἡμῶν,","targetText":"This is the Spirit He poured out on us abundantly through Jesus Christ our Savior,","groups":[{"id":0,"source":[0,2],"target":[0,18]},{"id":1,"source":[3,10],"target":[19,32]},{"id":2,"source":[11,14],"target":[33,35]},{"id":3,"source":[15,19],"target":[36,38]},{"id":4,"source":[20,28],"target":[39,49]},{"id":5,"source":[29,32],"target":[50,57]},{"id":6,"source":[33,38],"target":[58,63]},{"id":7,"source":[39,46],"target":[64,70]},{"id":10,"source":[59,64],"target":[71,74]},{"id":9,"source":[51,58],"target":[75,81]}]},"3:7":{"sourceText":"ἵνα δικαιωθέντες τῇ ἐκείνου χάριτι κληρονόμοι γενηθῶμεν κατ’ ἐλπίδα ζωῆς αἰωνίου.","targetText":"so that, having been justified by His grace, we would become heirs with the hope of eternal life.","groups":[{"id":0,"source":[0,3],"target":[0,7]},{"id":1,"source":[4,16],"target":[9,30]},{"id":3,"source":[20,27],"target":[31,37]},{"id":4,"source":[28,34],"target":[38,43]},{"id":6,"source":[46,55],"target":[45,60]},{"id":5,"source":[35,45],"target":[61,66]},{"id":7,"source":[56,60],"target":[67,71]},{"id":8,"source":[61,67],"target":[72,80]},{"id":10,"source":[73,81],"target":[81,91]},{"id":9,"source":[68,72],"target":[92,96]}]},"3:8":{"sourceText":"Πιστὸς ὁ λόγος, καὶ περὶ τούτων βούλομαί σε διαβεβαιοῦσθαι, ἵνα φροντίζωσιν καλῶν ἔργων προΐστασθαι οἱ πεπιστευκότες Θεῷ. ταῦτά ἐστιν καλὰ καὶ ὠφέλιμα τοῖς ἀνθρώποις·","targetText":"This saying is trustworthy. And I want you to emphasize these things, so that those who have believed God will take care to devote themselves to good deeds. These things are excellent and profitable for the people.","groups":[{"id":1,"source":[7,8],"target":[0,4]},{"id":2,"source":[9,15],"target":[5,11]},{"id":0,"source":[0,6],"target":[12,26]},{"id":3,"source":[16,19],"target":[28,31]},{"id":6,"source":[32,40],"target":[32,38]},{"id":7,"source":[41,43],"target":[39,42]},{"id":8,"source":[44,59],"target":[43,55]},{"id":5,"source":[25,31],"target":[56,68]},{"id":9,"source":[60,63],"target":[70,77]},{"id":14,"source":[100,102],"target":[78,87]},{"id":15,"source":[103,116],"target":[88,101]},{"id":16,"source":[117,121],"target":[102,105]},{"id":10,"source":[64,75],"target":[106,120]},{"id":13,"source":[88,99],"target":[121,144]},{"id":11,"source":[76,81],"target":[145,149]},{"id":12,"source":[82,87],"target":[150,155]},{"id":17,"source":[122,127],"target":[157,169]},{"id":18,"source":[128,133],"target":[170,173]},{"id":19,"source":[134,138],"target":[174,183]},{"id":20,"source":[139,142],"target":[184,187]},{"id":21,"source":[143,150],"target":[188,198]},{"id":22,"source":[151,155],"target":[199,206]},{"id":23,"source":[156,166],"target":[207,213]}]},"3:10":{"sourceText":"αἱρετικὸν ἄνθρωπον μετὰ μίαν καὶ δευτέραν νουθεσίαν παραιτοῦ,","targetText":"Reject a divisive man after a first and second admonition,","groups":[{"id":7,"source":[52,61],"target":[0,6]},{"id":0,"source":[0,9],"target":[7,17]},{"id":1,"source":[10,18],"target":[18,21]},{"id":2,"source":[19,23],"target":[22,27]},{"id":3,"source":[24,28],"target":[28,35]},{"id":4,"source":[29,32],"target":[36,39]},{"id":5,"source":[33,41],"target":[40,46]},{"id":6,"source":[42,51],"target":[47,57]}]},"3:11":{"sourceText":"εἰδὼς ὅτι ἐξέστραπται ὁ τοιοῦτος καὶ ἁμαρτάνει, ὢν αὐτοκατάκριτος.","targetText":"knowing that such a man is corrupt and sinful; he is self-condemned.","groups":[{"id":0,"source":[0,5],"target":[0,7]},{"id":1,"source":[6,9],"target":[8,12]},{"id":4,"source":[24,32],"target":[13,23]},{"id":2,"source":[10,21],"target":[24,34]},{"id":5,"source":[33,36],"target":[35,38]},{"id":6,"source":[37,47],"target":[39,45]},{"id":7,"source":[48,50],"target":[47,52]},{"id":8,"source":[51,66],"target":[53,67]}]},"3:12":{"sourceText":"Ὅταν πέμψω Ἀρτεμᾶν πρὸς σὲ ἢ Τυχικόν, σπούδασον ἐλθεῖν πρός με εἰς Νικόπολιν· ἐκεῖ γὰρ κέκρικα παραχειμάσαι.","targetText":"As soon as I send Artemas or Tychicus to you, make every effort to come to me at Nicopolis, because I have decided to winter there.","groups":[{"id":0,"source":[0,4],"target":[0,10]},{"id":1,"source":[5,10],"target":[11,17]},{"id":2,"source":[11,18],"target":[18,25]},{"id":5,"source":[27,28],"target":[26,28]},{"id":6,"source":[29,37],"target":[29,37]},{"id":3,"source":[19,23],"target":[38,40]},{"id":4,"source":[24,26],"target":[41,44]},{"id":7,"source":[38,47],"target":[46,63]},{"id":8,"source":[48,54],"target":[64,71]},{"id":9,"source":[55,59],"target":[72,74]},{"id":10,"source":[60,62],"target":[75,77]},{"id":11,"source":[63,66],"target":[78,80]},{"id":12,"source":[67,77],"target":[81,90]},{"id":14,"source":[83,86],"target":[92,99]},{"id":15,"source":[87,94],"target":[100,114]},{"id":16,"source":[95,108],"target":[115,124]},{"id":13,"source":[78,82],"target":[125,130]}]},"3:13":{"sourceText":"Ζηνᾶν τὸν νομικὸν καὶ Ἀπολλῶν σπουδαίως πρόπεμψον, ἵνα μηδὲν αὐτοῖς λείπῃ.","targetText":"Do your best to equip Zenas the lawyer and Apollos, so that they will have everything they need.","groups":[{"id":5,"source":[30,39],"target":[0,12]},{"id":6,"source":[40,50],"target":[13,21]},{"id":0,"source":[0,5],"target":[22,27]},{"id":1,"source":[6,9],"target":[28,31]},{"id":2,"source":[10,17],"target":[32,38]},{"id":3,"source":[18,21],"target":[39,42]},{"id":4,"source":[22,29],"target":[43,50]},{"id":7,"source":[51,54],"target":[52,59]},{"id":9,"source":[61,67],"target":[60,64]},{"id":10,"source":[68,74],"target":[65,95]}]},"3:14":{"sourceText":"μανθανέτωσαν δὲ καὶ οἱ ἡμέτεροι καλῶν ἔργων προΐστασθαι εἰς τὰς ἀναγκαίας χρείας, ἵνα μὴ ὦσιν ἄκαρποι.","targetText":"And our people must also learn to devote themselves to good works in order to meet the pressing needs of others, so that they will not be unfruitful.","groups":[{"id":1,"source":[13,15],"target":[0,3]},{"id":4,"source":[23,31],"target":[4,14]},{"id":2,"source":[16,19],"target":[15,24]},{"id":0,"source":[0,12],"target":[25,30]},{"id":7,"source":[44,55],"target":[31,54]},{"id":5,"source":[32,37],"target":[55,59]},{"id":6,"source":[38,43],"target":[60,65]},{"id":8,"source":[56,59],"target":[66,82]},{"id":10,"source":[64,73],"target":[83,95]},{"id":11,"source":[74,81],"target":[96,111]},{"id":12,"source":[82,85],"target":[113,120]},{"id":14,"source":[89,93],"target":[121,137]},{"id":15,"source":[94,102],"target":[138,148]}]},"3:15":{"sourceText":"Ἀσπάζονταί σε οἱ μετ’ ἐμοῦ πάντες. ἄσπασαι τοὺς φιλοῦντας ἡμᾶς ἐν πίστει. Ἡ χάρις μετὰ πάντων ὑμῶν.","targetText":"All who are with me send you greetings.  Greet those who love us in the faith.  Grace be with all of you.","groups":[{"id":5,"source":[27,34],"target":[0,3]},{"id":2,"source":[14,16],"target":[4,11]},{"id":3,"source":[17,21],"target":[12,16]},{"id":4,"source":[22,26],"target":[17,19]},{"id":0,"source":[0,10],"target":[20,38]},{"id":6,"source":[35,42],"target":[41,46]},{"id":7,"source":[43,47],"target":[47,56]},{"id":8,"source":[48,57],"target":[57,61]},{"id":9,"source":[58,62],"target":[62,64]},{"id":10,"source":[63,65],"target":[65,67]},{"id":11,"source":[66,73],"target":[68,77]},{"id":13,"source":[76,81],"target":[80,88]},{"id":14,"source":[82,86],"target":[89,93]},{"id":15,"source":[87,93],"target":[94,97]},{"id":16,"source":[94,99],"target":[98,104]}]}},"unavailable":{"1:7":"english-edition-differs","1:10":"greek-edition-differs","3:9":"greek-edition-differs"}}
