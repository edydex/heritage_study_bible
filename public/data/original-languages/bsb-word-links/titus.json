2]},{"id":1,"source":[4,10],"target":[3,11]},{"id":3,"source":[16,24],"target":[12,22]},{"id":2,"source":[11,15],"target":[23,27]},{"id":4,"source":[25,27],"target":[29,34]},{"id":8,"source":[50,54],"target":[35,38]},{"id":7,"source":[42,49],"target":[40,54]},{"id":5,"source":[28,39],"target":[56,64]},{"id":9,"source":[55,58],"target":[65,71]},{"id":10,"source":[59,65],"target":[72,76]},{"id":11,"source":[66,74],"target":[77,82]}]},"1:3":{"sourceText":"ἐφανέρωσεν δὲ καιροῖς ἰδίοις τὸν λόγον αὐτοῦ ἐν κηρύγματι ὃ ἐπιστεύθην ἐγὼ κατ’ ἐπιταγὴν τοῦ Σωτῆρος ἡμῶν Θεοῦ,","targetText":"In His own time He has made His word evident in the proclamation entrusted to me by the command of God our Savior.","groups":[{"id":3,"source":[22,28],"target":[0,10]},{"id":2,"source":[14,21],"target":[11,15]},{"id":0,"source":[0,10],"target":[16,27]},{"id":6,"source":[39,44],"target":[28,31]},{"id":5,"source":[33,38],"target":[32,44]},{"id":7,"source":[45,47],"target":[45,47]},{"id":8,"source":[48,57],"target":[48,64]},{"id":10,"source":[60,70],"target":[65,74]},{"id":11,"source":[71,74],"target":[75,80]},{"id":12,"source":[75,79],"target":[81,83]},{"id":13,"source":[80,88],"target":[84,95]},{"id":17,"source":[106,111],"target":[96,102]},{"id":16,"source":[101,105],"target":[103,106]},{"id":15,"source":[93,100],"target":[107,113]}]},"1:4":{"sourceText":"Τίτῳ γνησίῳ τέκνῳ κατὰ κοινὴν πίστιν· χάρις καὶ εἰρήνη ἀπὸ Θεοῦ Πατρὸς καὶ Χριστοῦ Ἰησοῦ τοῦ Σωτῆρος ἡμῶν.","targetText":"To Titus, my true child in our common faith:  Grace and peace from God the Father and Christ Jesus our Savior.","groups":[{"id":0,"source":[0,4],"target":[0,8]},{"id":1,"source":[5,11],"target":[10,17]},{"id":2,"source":[12,17],"target":[18,23]},{"id":3,"source":[18,22],"target":[24,26]},{"id":4,"source":[23,29],"target":[27,37]},{"id":5,"source":[30,37],"target":[38,43]},{"id":6,"source":[38,43],"target":[46,51]},{"id":7,"source":[44,47],"target":[52,55]},{"id":8,"source":[48,54],"target":[56,61]},{"id":9,"source":[55,58],"target":[62,66]},{"id":10,"source":[59,63],"target":[67,70]},{"id":11,"source":[64,70],"target":[71,81]},{"id":12,"source":[71,74],"target":[82,85]},{"id":13,"source":[75,82],"target":[86,92]},{"id":14,"source":[83,88],"target":[93,98]},{"id":17,"source":[101,106],"target":[99,102]},{"id":16,"source":[93,100],"target":[103,109]}]},"1:5":{"sourceText":"Τούτου χάριν ἀπέλιπόν σε ἐν Κρήτῃ ἵνα τὰ λείποντα ἐπιδιορθώσῃ, καὶ καταστήσῃς κατὰ πόλιν πρεσβυτέρους, ὡς ἐγώ σοι διεταξάμην,","targetText":"The reason I left you in Crete was that you would set in order what was unfinished and appoint elders in every town, as I directed you.","groups":[{"id":1,"source":[7,12],"target":[0,10]},{"id":2,"source":[13,21],"target":[11,17]},{"id":3,"source":[22,24],"target":[18,21]},{"id":4,"source":[25,27],"target":[22,24]},{"id":5,"source":[28,33],"target":[25,30]},{"id":6,"source":[34,37],"target":[31,39]},{"id":9,"source":[50,62],"target":[40,62]},{"id":7,"source":[38,40],"target":[63,71]},{"id":8,"source":[41,49],"target":[72,82]},{"id":10,"source":[63,66],"target":[83,86]},{"id":11,"source":[67,77],"target":[87,94]},{"id":14,"source":[89,102],"target":[95,101]},{"id":12,"source":[78,82],"target":[102,110]},{"id":13,"source":[83,88],"target":[111,115]},{"id":15,"source":[103,105],"target":[117,119]},{"id":16,"source":[106,109],"target":[120,121]},{"id":18,"source":[114,125],"target":[122,130]},{"id":17,"source":[110,113],"target":[131,134]}]},"1:6":{"sourceText":"εἴ τίς ἐστιν ἀνέγκλητος, μιᾶς γυναικὸς ἀνήρ, τέκνα ἔχων πιστά, μὴ ἐν κατηγορίᾳ ἀσωτίας ἢ ἀνυπότακτα.","targetText":"An elder must be blameless, the husband of but one wife, having children who are believers and who are not open to accusation of indiscretion or insubordination.","groups":[{"id":0,"source":[0,2],"target":[0,13]},{"id":2,"source":[7,12],"target":[14,16]},{"id":3,"source":[13,24],"target":[17,26]},{"id":6,"source":[39,44],"target":[28,39]},{"id":4,"source":[25,29],"target":[40,50]},{"id":5,"source":[30,38],"target":[51,55]},{"id":8,"source":[51,55],"target":[57,63]},{"id":7,"source":[45,50],"target":[64,72]},{"id":9,"source":[56,62],"target":[73,90]},{"id":10,"source":[63,65],"target":[91,106]},{"id":11,"source":[66,68],"target":[107,114]},{"id":12,"source":[69,78],"target":[115,125]},{"id":13,"source":[79,86],"target":[126,141]},{"id":14,"source":[87,88],"target":[142,144]},{"id":15,"source":[89,100],"target":[145,160]}]},"1:8":{"sourceText":"ἀλλὰ φιλόξενον, φιλάγαθον, σώφρονα, δίκαιον, ὅσιον, ἐγκρατῆ,","targetText":"Instead, he must be hospitable, a lover of good, self-controlled, upright, holy, and disciplined.","groups":[{"id":0,"source":[0,4],"target":[0,7]},{"id":1,"source":[5,15],"target":[9,30]},{"id":2,"source":[16,26],"target":[32,47]},{"id":3,"source":[27,35],"target":[49,64]},{"id":4,"source":[36,44],"target":[66,73]},{"id":5,"source":[45,51],"target":[75,79]},{"id":6,"source":[52,60],"target":[81,96]}]},"1:9":{"sourceText":"ἀντεχόμενον τοῦ κατὰ τὴν διδαχὴν πιστοῦ λόγου, ἵνα δυνατὸς ᾖ καὶ παρακαλεῖν ἐν τῇ διδασκαλίᾳ τῇ ὑγιαινούσῃ καὶ τοὺς ἀντιλέγοντας ἐλέγχειν.","targetText":"He must hold firmly to the faithful word as it was taught, so that he can encourage others by sound teaching and refute those who contradict it.","groups":[{"id":0,"source":[0,11],"target":[0,19]},{"id":1,"source":[12,15],"target":[20,26]},{"id":5,"source":[33,39],"target":[27,35]},{"id":6,"source":[40,46],"target":[36,40]},{"id":2,"source":[16,20],"target":[41,43]},{"id":4,"source":[25,32],"target":[44,57]},{"id":7,"source":[47,50],"target":[59,66]},{"id":9,"source":[59,60],"target":[67,73]},{"id":11,"source":[65,75],"target":[74,90]},{"id":12,"source":[76,78],"target":[91,93]},{"id":16,"source":[96,106],"target":[94,99]},{"id":14,"source":[82,92],"target":[100,108]},{"id":17,"source":[107,110],"target":[109,112]},{"id":20,"source":[129,138],"target":[113,119]},{"id":18,"source":[111,115],"target":[120,129]},{"id":19,"source":[116,128],"target":[130,143]}]},"1:11":{"sourceText":"οὓς δεῖ ἐπιστομίζειν, οἵτινες ὅλους οἴκους ἀνατρέπουσιν διδάσκοντες ἃ μὴ δεῖ αἰσχροῦ κέρδους χάριν.","targetText":"who must be silenced. For the sake of dishonorable gain, they undermine entire households and teach things they should not.","groups":[{"id":0,"source":[0,3],"target":[0,3]},{"id":1,"source":[4,7],"target":[4,8]},{"id":2,"source":[8,21],"target":[9,20]},{"id":13,"source":[93,99],"target":[22,37]},{"id":11,"source":[77,84],"target":[38,50]},{"id":12,"source":[85,92],"target":[51,55]},{"id":3,"source":[22,29],"target":[57,61]},{"id":6,"source":[43,55],"target":[62,71]},{"id":4,"source":[30,35],"target":[72,78]},{"id":5,"source":[36,42],"target":[79,89]},{"id":7,"source":[56,67],"target":[90,99]},{"id":8,"source":[68,69],"target":[100,106]},{"id":10,"source":[73,76],"target":[107,118]},{"id":9,"source":[70,72],"target":[119,122]}]},"1:12":{"sourceText":"εἶπέν τις ἐξ αὐτῶν ἴδιος αὐτῶν προφήτης Κρῆτες ἀεὶ ψεῦσται, κακὰ θηρία, γαστέρες ἀργαί.","targetText":"As one of their own prophets has said, “Cretans are always liars, evil beasts, lazy gluttons.”","groups":[{"id":1,"source":[6,9],"target":[0,6]},{"id":2,"source":[10,12],"target":[7,9]},{"id":5,"source":[25,30],"target":[10,15]},{"id":4,"source":[19,24],"target":[16,19]},{"id":6,"source":[31,39],"target":[20,28]},{"id":0,"source":[0,5],"target":[29,37]},{"id":7,"source":[40,46],"target":[40,47]},{"id":8,"source":[47,50],"target":[48,58]},{"id":9,"source":[51,59],"target":[59,64]},{"id":10,"source":[60,64],"target":[66,70]},{"id":11,"source":[65,71],"target":[71,77]},{"id":13,"source":[81,87],"target":[79,83]},{"id":12,"source":[72,80],"target":[84,92]}]},"1:13":{"sourceText":"ἡ μαρτυρία αὕτη ἐστὶν ἀληθής. δι’ ἣν αἰτίαν ἔλεγχε αὐτοὺς ἀποτόμως, ἵνα ὑγιαίνωσιν ἐν τῇ πίστει,","targetText":"This testimony is true. Therefore rebuke them sternly, so that they will be sound in the faith","groups":[{"id":2,"source":[11,15],"target":[0,4]},{"id":1,"source":[2,10],"target":[5,14]},{"id":3,"source":[16,21],"target":[15,17]},{"id":4,"source":[22,29],"target":[18,22]},{"id":7,"source":[37,43],"target":[24,33]},{"id":8,"source":[44,50],"target":[34,40]},{"id":9,"source":[51,57],"target":[41,45]},{"id":10,"source":[58,67],"target":[46,53]},{"id":11,"source":[68,71],"target":[55,62]},{"id":12,"source":[72,82],"target":[63,81]},{"id":13,"source":[83,85],"target":[82,84]},{"id":14,"source":[86,88],"target":[85,88]},{"id":15,"source":[89,96],"target":[89,94]}]},"1:14":{"sourceText":"μὴ προσέχοντες Ἰουδαϊκοῖς μύθοις καὶ ἐντολαῖς ἀνθρώπων ἀποστρεφομένων τὴν ἀλήθειαν.","targetText":"and will pay no attention to Jewish myths or to the commands of men who have rejected the truth.","groups":[{"id":1,"source":[3,14],"target":[0,25]},{"id":2,"source":[15,25],"target":[26,35]},{"id":3,"source":[26,32],"target":[36,41]},{"id":4,"source":[33,36],"target":[42,44]},{"id":5,"source":[37,45],"target":[45,60]},{"id":6,"source":[46,54],"target":[61,67]},{"id":7,"source":[55,69],"target":[68,85]},{"id":8,"source":[70,73],"target":[86,89]},{"id":9,"source":[74,83],"target":[90,95]}]},"1:15":{"sourceText":"πάντα καθαρὰ τοῖς καθαροῖς· τοῖς δὲ μεμιαμμένοις καὶ ἀπίστοις οὐδὲν καθαρόν, ἀλλὰ μεμίανται αὐτῶν καὶ ὁ νοῦς καὶ ἡ συνείδησις.","targetText":"To the pure, all things are pure; but to the defiled and unbelieving, nothing is pure. Indeed, both their minds and their consciences are defiled.","groups":[{"id":2,"source":[13,17],"target":[0,6]},{"id":3,"source":[18,27],"target":[7,11]},{"id":0,"source":[0,5],"target":[13,27]},{"id":1,"source":[6,12],"target":[28,32]},{"id":5,"source":[33,35],"target":[34,37]},{"id":4,"source":[28,32],"target":[38,44]},{"id":6,"source":[36,48],"target":[45,52]},{"id":7,"source":[49,52],"target":[53,56]},{"id":8,"source":[53,61],"target":[57,68]},{"id":9,"source":[62,67],"target":[70,77]},{"id":10,"source":[68,76],"target":[78,85]},{"id":11,"source":[77,81],"target":[87,93]},{"id":14,"source":[98,101],"target":[95,99]},{"id":13,"source":[92,97],"target":[100,105]},{"id":16,"source":[104,108],"target":[106,111]},{"id":17,"source":[109,112],"target":[112,115]},{"id":18,"source":[113,114],"target":[116,121]},{"id":19,"source":[115,126],"target":[122,133]},{"id":12,"source":[82,91],"target":[134,145]}]},"1:16":{"sourceText":"Θεὸν ὁμολογοῦσιν εἰδέναι, τοῖς δὲ ἔργοις ἀρνοῦνται, βδελυκτοὶ ὄντες καὶ ἀπειθεῖς καὶ πρὸς πᾶν ἔργον ἀγαθὸν ἀδόκιμοι.","targetText":"They profess to know God, but by their actions they deny Him. They are detestable, disobedient, and unfit for any good deed.","groups":[{"id":1,"source":[5,16],"target":[0,12]},{"id":2,"source":[17,25],"target":[13,20]},{"id":0,"source":[0,4],"target":[21,24]},{"id":4,"source":[31,33],"target":[26,29]},{"id":3,"source":[26,30],"target":[30,38]},{"id":5,"source":[34,40],"target":[39,46]},{"id":6,"source":[41,51],"target":[47,60]},{"id":8,"source":[62,67],"target":[62,70]},{"id":7,"source":[52,61],"target":[71,81]},{"id":10,"source":[72,80],"target":[83,94]},{"id":11,"source":[81,84],"target":[96,99]},{"id":16,"source":[107,116],"target":[100,105]},{"id":12,"source":[85,89],"target":[106,109]},{"id":13,"source":[90,93],"target":[110,113]},{"id":15,"source":[100,106],"target":[114,118]},{"id":14,"source":[94,99],"target":[119,123]}]},"2:1":{"sourceText":"Σὺ δὲ λάλει ἃ πρέπει τῇ ὑγιαινούσῃ διδασκαλίᾳ.","targetText":"But as for you, speak the things that are consistent with sound doctrine.","groups":[{"id":1,"source":[3,5],"target":[0,3]},{"id":0,"source":[0,2],"target":[4,14]},{"id":2,"source":[6,11],"target":[16,21]},{"id":3,"source":[12,13],"target":[22,37]},{"id":4,"source":[14,20],"target":[38,57]},{"id":6,"source":[24,34],"target":[58,63]},{"id":7,"source":[35,46],"target":[64,72]}]},"2:2":{"sourceText":"πρεσβύτας νηφαλίους εἶναι, σεμνούς, σώφρονας, ὑγιαίνοντας τῇ πίστει, τῇ ἀγάπῃ, τῇ ὑπομονῇ·","targetText":"Older men are to be temperate, dignified, self-controlled, and sound in faith, love, and perseverance.","groups":[{"id":0,"source":[0,9],"target":[0,9]},{"id":2,"source":[20,26],"target":[10,19]},{"id":1,"source":[10,19],"target":[20,29]},{"id":3,"source":[27,35],"target":[31,40]},{"id":4,"source":[36,45],"target":[42,57]},{"id":5,"source":[46,57],"target":[59,68]},{"id":7,"source":[61,68],"target":[69,77]},{"id":9,"source":[72,78],"target":[79,83]},{"id":10,"source":[79,81],"target":[85,88]},{"id":11,"source":[82,90],"target":[89,101]}]},"2:3":{"sourceText":"πρεσβύτιδας ὡσαύτως ἐν καταστήματι ἱεροπρεπεῖς, μὴ διαβόλους μηδὲ οἴνῳ πολλῷ δεδουλωμένας, καλοδιδασκάλους,","targetText":"Older women, likewise, are to be reverent in their behavior, not slanderers or addicted to much wine, but teachers of good.","groups":[{"id":0,"source":[0,11],"target":[0,11]},{"id":1,"source":[12,19],"target":[13,21]},{"id":4,"source":[35,47],"target":[23,41]},{"id":2,"source":[20,22],"target":[42,44]},{"id":3,"source":[23,34],"target":[45,59]},{"id":5,"source":[48,50],"target":[61,64]},{"id":6,"source":[51,60],"target":[65,75]},{"id":7,"source":[61,65],"target":[76,78]},{"id":10,"source":[77,90],"target":[79,87]},{"id":9,"source":[71,76],"target":[88,95]},{"id":8,"source":[66,70],"target":[96,100]},{"id":11,"source":[91,107],"target":[102,122]}]},"2:4":{"sourceText":"ἵνα σωφρονίζωσιν τὰς νέας φιλάνδρους εἶναι, φιλοτέκνους,","targetText":"In this way they can train the young women to love their husbands and children,","groups":[{"id":0,"source":[0,3],"target":[0,11]},{"id":1,"source":[4,16],"target":[12,26]},{"id":2,"source":[17,20],"target":[27,30]},{"id":3,"source":[21,25],"target":[31,42]},{"id":5,"source":[37,43],"target":[43,45]},{"id":4,"source":[26,36],"target":[46,65]},{"id":6,"source":[44,56],"target":[66,78]}]},"2:5":{"sourceText":"σώφρονας, ἁγνάς, οἰκουργούς, ἀγαθάς, ὑποτασσομένας τοῖς ἰδίοις ἀνδράσιν, ἵνα μὴ ὁ λόγος τοῦ Θεοῦ βλασφημῆται.","targetText":"to be self-controlled, pure, managers of their households, kind, and submissive to their own husbands, so that the word of God will not be discredited.","groups":[{"id":0,"source":[0,9],"target":[0,21]},{"id":1,"source":[10,16],"target":[23,27]},{"id":2,"source":[17,28],"target":[29,57]},{"id":3,"source":[29,36],"target":[59,63]},{"id":4,"source":[37,50],"target":[65,79]},{"id":5,"source":[51,55],"target":[80,88]},{"id":6,"source":[56,62],"target":[89,92]},{"id":7,"source":[63,72],"target":[93,101]},{"id":8,"source":[73,76],"target":[103,110]},{"id":10,"source":[80,81],"target":[111,114]},{"id":11,"source":[82,87],"target":[115,119]},{"id":13,"source":[92,96],"target":[120,126]},{"id":14,"source":[97,109],"target":[127,150]}]},"2:6":{"sourceText":"Τοὺς νεωτέρους ὡσαύτως παρακάλει σωφρονεῖν","targetText":"In the same way, urge the younger men to be self-controlled.","groups":[{"id":2,"source":[15,22],"target":[0,15]},{"id":3,"source":[23,32],"target":[17,21]},{"id":0,"source":[0,4],"target":[22,25]},{"id":1,"source":[5,14],"target":[26,37]},{"id":4,"source":[33,42],"target":[38,59]}]},"2:7":{"sourceText":"περὶ πάντα, σεαυτὸν παρεχόμενος τύπον καλῶν ἔργων, ἐν τῇ διδασκαλίᾳ ἀφθορίαν, σεμνότητα,","targetText":"In everything, show yourself to be an example by doing good works. In your teaching show integrity, dignity,","groups":[{"id":0,"source":[0,4],"target":[0,2]},{"id":1,"source":[5,11],"target":[3,13]},{"id":3,"source":[20,31],"target":[15,19]},{"id":2,"source":[12,19],"target":[20,28]},{"id":4,"source":[32,37],"target":[29,45]},{"id":5,"source":[38,43],"target":[46,59]},{"id":6,"source":[44,50],"target":[60,65]},{"id":7,"source":[51,53],"target":[67,69]},{"id":8,"source":[54,56],"target":[70,74]},{"id":9,"source":[57,67],"target":[75,83]},{"id":10,"source":[68,77],"target":[84,98]},{"id":11,"source":[78,88],"target":[100,107]}]},"2:8":{"sourceText":"λόγον ὑγιῆ ἀκατάγνωστον, ἵνα ὁ ἐξ ἐναντίας ἐντραπῇ μηδὲν ἔχων λέγειν περὶ ἡμῶν φαῦλον.","targetText":"and wholesome speech that is above reproach, so that anyone who opposes us will be ashamed, having nothing bad to say about us.","groups":[{"id":1,"source":[6,10],"target":[0,13]},{"id":0,"source":[0,5],"target":[14,20]},{"id":2,"source":[11,24],"target":[21,43]},{"id":3,"source":[25,28],"target":[45,52]},{"id":4,"source":[29,30],"target":[53,59]},{"id":5,"source":[31,33],"target":[60,63]},{"id":6,"source":[34,42],"target":[64,74]},{"id":7,"source":[43,50],"target":[75,90]},{"id":9,"source":[57,61],"target":[92,98]},{"id":8,"source":[51,56],"target":[99,106]},{"id":13,"source":[79,86],"target":[107,110]},{"id":10,"source":[62,68],"target":[111,117]},{"id":11,"source":[69,73],"target":[118,123]},{"id":12,"source":[74,78],"target":[124,126]}]},"2:9":{"sourceText":"δούλους ἰδίοις δεσπόταις ὑποτάσσεσθαι ἐν πᾶσιν, εὐαρέστους εἶναι, μὴ ἀντιλέγοντας,","targetText":"Slaves are to submit to their own masters in everything, to be well-pleasing, not argumentative,","groups":[{"id":0,"source":[0,7],"target":[0,6]},{"id":3,"source":[25,37],"target":[7,20]},{"id":1,"source":[8,14],"target":[21,33]},{"id":2,"source":[15,24],"target":[34,41]},{"id":4,"source":[38,40],"target":[42,44]},{"id":5,"source":[41,47],"target":[45,55]},{"id":7,"source":[59,65],"target":[57,62]},{"id":6,"source":[48,58],"target":[63,76]},{"id":8,"source":[66,68],"target":[78,81]},{"id":9,"source":[69,82],"target":[82,95]}]},"2:10":{"sourceText":"μὴ νοσφιζομένους, ἀλλὰ πᾶσαν πίστιν ἐνδεικνυμένους ἀγαθήν, ἵνα τὴν διδασκαλίαν τὴν τοῦ Σωτῆρος ἡμῶν Θεοῦ κοσμῶσιν ἐν πᾶσιν.","targetText":"not stealing from them, but showing all good faith, so that in every respect they will adorn the teaching about God our Savior.","groups":[{"id":0,"source":[0,2],"target":[0,3]},{"id":1,"source":[3,17],"target":[4,22]},{"id":2,"source":[18,22],"target":[24,27]},{"id":5,"source":[36,50],"target":[28,35]},{"id":3,"source":[23,28],"target":[36,39]},{"id":6,"source":[51,58],"target":[40,44]},{"id":4,"source":[29,35],"target":[45,50]},{"id":7,"source":[59,62],"target":[52,59]},{"id":16,"source":[114,116],"target":[60,62]},{"id":17,"source":[117,123],"target":[63,76]},{"id":15,"source":[105,113],"target":[77,92]},{"id":8,"source":[63,66],"target":[93,96]},{"id":9,"source":[67,78],"target":[97,105]},{"id":10,"source":[79,82],"target":[106,111]},{"id":14,"source":[100,104],"target":[112,115]},{"id":13,"source":[95,99],"target":[116,119]},{"id":12,"source":[87,94],"target":[120,126]}]},"2:11":{"sourceText":"Ἐπεφάνη γὰρ ἡ χάρις τοῦ Θεοῦ σωτήριος πᾶσιν ἀνθρώποις,","targetText":"For the grace of God has appeared, bringing salvation to everyone.","groups":[{"id":1,"source":[8,11],"target":[0,3]},{"id":2,"source":[12,13],"target":[4,7]},{"id":3,"source":[14,19],"target":[8,13]},{"id":5,"source":[24,28],"target":[14,20]},{"id":0,"source":[0,7],"target":[21,33]},{"id":6,"source":[29,37],"target":[35,53]},{"id":7,"source":[38,43],"target":[54,65]}]},"2:12":{"sourceText":"παιδεύουσα ἡμᾶς, ἵνα ἀρνησάμενοι τὴν ἀσέβειαν καὶ τὰς κοσμικὰς ἐπιθυμίας σωφρόνως καὶ δικαίως καὶ εὐσεβῶς ζήσωμεν ἐν τῷ νῦν αἰῶνι,","targetText":"It instructs us to renounce ungodliness and worldly passions, and to live sensible, upright, and godly lives in the present age,","groups":[{"id":0,"source":[0,10],"target":[0,12]},{"id":1,"source":[11,16],"target":[13,15]},{"id":2,"source":[17,20],"target":[16,18]},{"id":3,"source":[21,32],"target":[19,27]},{"id":5,"source":[37,45],"target":[28,39]},{"id":6,"source":[46,49],"target":[40,43]},{"id":8,"source":[54,62],"target":[44,51]},{"id":9,"source":[63,72],"target":[52,60]},{"id":15,"source":[106,113],"target":[62,73]},{"id":10,"source":[73,81],"target":[74,82]},{"id":12,"source":[86,93],"target":[84,91]},{"id":13,"source":[94,97],"target":[93,96]},{"id":14,"source":[98,105],"target":[97,108]},{"id":16,"source":[114,116],"target":[109,111]},{"id":17,"source":[117,119],"target":[112,115]},{"id":18,"source":[120,123],"target":[116,123]},{"id":19,"source":[124,130],"target":[124,127]}]},"2:13":{"sourceText":"προσδεχόμενοι τὴν μακαρίαν ἐλπίδα καὶ ἐπιφάνειαν τῆς δόξης τοῦ μεγάλου Θεοῦ καὶ Σωτῆρος ἡμῶν Χριστοῦ Ἰησοῦ,","targetText":"as we await the blessed hope and glorious appearance of our great God and Savior Jesus Christ.","group