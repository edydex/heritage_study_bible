{"schemaVersion":1,"book":"Jude","sourceId":"N1904","targetId":"BSB","provenance":{"url":"https://bereanbible.com/bsb_tables.tsv","license":"CC0","licenseUrl":"https://berean.bible/terms.htm","tableSha256":"09bbee6f9fe4fa22b5df28e8a9ffa99bf9c33435f4eb8c47c2dc221d855d35cb","targetSha256":"8afd83b240d4ac4168127d4d039896a2245883d431e9125899b6adcbd5b32285","greekSha256":"3beee6abb6302f691110fe0fc949fc195593b999cf2d0e463c9b573c1bb67150"},"method":"Publisher row links transferred only when the whole Greek and English verse word sequences agree; Greek comparison ignores accents, case and punctuation. English comparison ignores case and punctuation. No inferred synonym or Strong-number matching.","verses":{"1:1":{"sourceText":"Ἰούδας Ἰησοῦ Χριστοῦ δοῦλος, ἀδελφὸς δὲ Ἰακώβου, τοῖς ἐν Θεῷ Πατρὶ ἠγαπημένοις καὶ Ἰησοῦ Χριστῷ τετηρημένοις κλητοῖς.","targetText":"Jude, a servant of Jesus Christ and a brother of James,  To those who are called, loved by God the Father, and kept in Jesus Christ:","groups":[{"id":0,"source":[0,6],"target":[0,4]},{"id":3,"source":[21,28],"target":[6,15]},{"id":1,"source":[7,12],"target":[16,24]},{"id":2,"source":[13,20],"target":[25,31]},{"id":5,"source":[37,39],"target":[32,35]},{"id":4,"source":[29,36],"target":[36,45]},{"id":6,"source":[40,48],"target":[46,54]},{"id":7,"source":[49,53],"target":[57,73]},{"id":16,"source":[109,117],"target":[74,80]},{"id":11,"source":[67,78],"target":[82,87]},{"id":8,"source":[54,56],"target":[88,90]},{"id":9,"source":[57,60],"target":[91,94]},{"id":10,"source":[61,66],"target":[95,105]},{"id":12,"source":[79,82],"target":[107,110]},{"id":15,"source":[96,108],"target":[111,115]},{"id":13,"source":[83,88],"target":[116,124]},{"id":14,"source":[89,95],"target":[125,131]}]},"1:2":{"sourceText":"ἔλεος ὑμῖν καὶ εἰρήνη καὶ ἀγάπη πληθυνθείη.","targetText":"Mercy, peace, and love be multiplied to you.","groups":[{"id":0,"source":[0,5],"target":[0,5]},{"id":3,"source":[15,21],"target":[7,12]},{"id":4,"source":[22,25],"target":[14,17]},{"id":5,"source":[26,31],"target":[18,22]},{"id":6,"source":[32,43],"target":[23,36]},{"id":1,"source":[6,10],"target":[37,43]}]},"1:3":{"sourceText":"Ἀγαπητοί, πᾶσαν σπουδὴν ποιούμενος γράφειν ὑμῖν περὶ τῆς κοινῆς ἡμῶν σωτηρίας, ἀνάγκην ἔσχον γράψαι ὑμῖν παρακαλῶν ἐπαγωνίζεσθαι τῇ ἅπαξ παραδοθείσῃ τοῖς ἁγίοις πίστει.","targetText":"Beloved, although I made every effort to write to you about the salvation we share, I felt it necessary to write and urge you to contend earnestly for the faith entrusted once for all to the saints.","groups":[{"id":0,"source":[0,9],"target":[0,7]},{"id":3,"source":[24,34],"target":[9,24]},{"id":1,"source":[10,15],"target":[25,30]},{"id":2,"source":[16,23],"target":[31,37]},{"id":4,"source":[35,42],"target":[38,46]},{"id":5,"source":[43,47],"target":[47,53]},{"id":6,"source":[48,52],"target":[54,59]},{"id":7,"source":[53,56],"target":[60,63]},{"id":10,"source":[69,78],"target":[64,73]},{"id":9,"source":[64,68],"target":[74,76]},{"id":8,"source":[57,63],"target":[77,82]},{"id":12,"source":[87,92],"target":[84,90]},{"id":11,"source":[79,86],"target":[91,103]},{"id":13,"source":[93,99],"target":[104,112]},{"id":15,"source":[105,114],"target":[113,121]},{"id":14,"source":[100,104],"target":[122,125]},{"id":16,"source":[115,128],"target":[126,146]},{"id":17,"source":[129,131],"target":[147,154]},{"id":22,"source":[161,168],"target":[155,160]},{"id":19,"source":[137,148],"target":[161,170]},{"id":18,"source":[132,136],"target":[171,183]},{"id":20,"source":[149,153],"target":[184,190]},{"id":21,"source":[154,160],"target":[191,197]}]},"1:6":{"sourceText":"ἀγγέλους τε τοὺς μὴ τηρήσαντας τὴν ἑαυτῶν ἀρχὴν ἀλλὰ ἀπολιπόντας τὸ ἴδιον οἰκητήριον εἰς κρίσιν μεγάλης ἡμέρας δεσμοῖς ἀϊδίοις ὑπὸ ζόφον τετήρηκεν·","targetText":"And the angels who did not stay within their own domain but abandoned their proper dwelling—these He has kept in eternal chains under darkness, bound for judgment on that great day.","groups":[{"id":1,"source":[9,11],"tar