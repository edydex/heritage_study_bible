id":19,"source":[124,134],"target":[124,138]},{"id":20,"source":[135,141],"target":[139,152]},{"id":24,"source":[162,172],"target":[153,173]},{"id":23,"source":[156,161],"target":[174,188]},{"id":22,"source":[148,155],"target":[189,199]},{"id":21,"source":[142,147],"target":[200,204]}]},"1:8":{"sourceText":"Ὁμοίως μέντοι καὶ οὗτοι ἐνυπνιαζόμενοι σάρκα μὲν μιαίνουσιν, κυριότητα δὲ ἀθετοῦσιν, δόξας δὲ βλασφημοῦσιν.","targetText":"Yet in the same way these dreamers defile their bodies, reject authority, and slander glorious beings.","groups":[{"id":1,"source":[7,13],"target":[0,3]},{"id":0,"source":[0,6],"target":[4,19]},{"id":3,"source":[18,23],"target":[20,25]},{"id":4,"source":[24,38],"target":[26,34]},{"id":7,"source":[49,60],"target":[35,41]},{"id":5,"source":[39,44],"target":[42,54]},{"id":10,"source":[74,84],"target":[56,62]},{"id":8,"source":[61,70],"target":[63,72]},{"id":12,"source":[91,93],"target":[74,77]},{"id":13,"source":[94,107],"target":[78,85]},{"id":11,"source":[85,90],"target":[86,101]}]},"1:9":{"sourceText":"ὁ δὲ Μιχαὴλ ὁ ἀρχάγγελος, ὅτε τῷ διαβόλῳ διακρινόμενος διελέγετο περὶ τοῦ Μωϋσέως σώματος, οὐκ ἐτόλμησεν κρίσιν ἐπενεγκεῖν βλασφημίας, ἀλλὰ εἶπεν Ἐπιτιμήσαι σοι Κύριος.","targetText":"But even the archangel Michael, when he disputed with the devil over the body of Moses, did not presume to bring a slanderous charge against him, but said, “The Lord rebuke you!”","groups":[{"id":1,"source":[2,4],"target":[0,8]},{"id":3,"source":[12,13],"target":[9,12]},{"id":4,"source":[14,25],"target":[13,22]},{"id":2,"source":[5,11],"target":[23,30]},{"id":5,"source":[26,29],"target":[32,36]},{"id":8,"source":[41,54],"target":[37,48]},{"id":6,"source":[30,32],"target":[49,57]},{"id":7,"source":[33,40],"target":[58,63]},{"id":10,"source":[65,69],"target":[64,68]},{"id":11,"source":[70,73],"target":[69,72]},{"id":13,"source":[82,90],"target":[73,77]},{"id":12,"source":[74,81],"target":[78,86]},{"id":15,"source":[95,104],"target":[88,103]},{"id":17,"source":[112,122],"target":[104,112]},{"id":18,"source":[123,134],"target":[113,125]},{"id":16,"source":[105,111],"target":[126,144]},{"id":19,"source":[135,139],"target":[146,149]},{"id":20,"source":[140,145],"target":[150,154]},{"id":23,"source":[161,168],"target":[157,165]},{"id":21,"source":[146,156],"target":[166,172]},{"id":22,"source":[157,160],"target":[173,176]}]},"1:10":{"sourceText":"οὗτοι δὲ ὅσα μὲν οὐκ οἴδασιν βλασφημοῦσιν, ὅσα δὲ φυσικῶς ὡς τὰ ἄλογα ζῷα ἐπίστανται, ἐν τούτοις φθείρονται.","targetText":"These men, however, slander what they do not understand, and like irrational animals, they will be destroyed by the things they do instinctively.","groups":[{"id":0,"source":[0,5],"target":[0,9]},{"id":1,"source":[6,8],"target":[11,18]},{"id":6,"source":[29,42],"target":[20,27]},{"id":7,"source":[43,46],"target":[28,32]},{"id":5,"source":[21,28],"target":[33,55]},{"id":8,"source":[47,49],"target":[57,60]},{"id":10,"source":[58,60],"target":[61,65]},{"id":12,"source":[64,69],"target":[66,76]},{"id":13,"source":[70,73],"target":[77,84]},{"id":17,"source":[97,108],"target":[86,108]},{"id":15,"source":[86,88],"target":[109,111]},{"id":16,"source":[89,96],"target":[112,122]},{"id":14,"source":[74,85],"target":[123,144]}]},"1:12":{"sourceText":"Οὗτοί εἰσιν οἱ ἐν ταῖς ἀγάπαις ὑμῶν σπιλάδες συνευωχούμενοι ἀφόβως, ἑαυτοὺς ποιμαίνοντες, νεφέλαι ἄνυδροι ὑπὸ ἀνέμων παραφερόμεναι, δένδρα φθινοπωρινὰ ἄκαρπα δὶς ἀποθανόντα ἐκριζωθέντα,","targetText":"These men are hidden reefs in your love feasts, shamelessly feasting with you but shepherding only themselves. They are clouds without water, carried along by the wind; fruitless trees in autumn, twice dead after being uprooted.","groups":[{"id":0,"source":[0,5],"target":[0,9]},{"id":1,"source":[6,11],"target":[10,13]},{"id":7,"source":[36,44],"target":[14,26]},{"id":3,"source":[15,17],"target":[27,29]},{"id":6,"source":[31,35],"target":[30,34]},{"id":5,"source":[23,30],"target":[35,46]},{"id":9,"source":[60,67],"target":[48,59]},{"id":