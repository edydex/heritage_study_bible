,137],"target":[134,143]}]},"1:17":{"sourceText":"Ὑμεῖς δέ, ἀγαπητοί, μνήσθητε τῶν ῥημάτων τῶν προειρημένων ὑπὸ τῶν ἀποστόλων τοῦ Κυρίου ἡμῶν Ἰησοῦ Χριστοῦ,","targetText":"But you, beloved, remember what was foretold by the apostles of our Lord Jesus Christ","groups":[{"id":1,"source":[6,9],"target":[0,3]},{"id":0,"source":[0,5],"target":[4,7]},{"id":2,"source":[10,19],"target":[9,16]},{"id":3,"source":[20,28],"target":[18,26]},{"id":4,"source":[29,32],"target":[27,31]},{"id":7,"source":[45,57],"target":[32,44]},{"id":8,"source":[58,61],"target":[45,47]},{"id":9,"source":[62,65],"target":[48,51]},{"id":10,"source":[66,75],"target":[52,60]},{"id":13,"source":[87,91],"target":[61,67]},{"id":12,"source":[80,86],"target":[68,72]},{"id":14,"source":[92,97],"target":[73,78]},{"id":15,"source":[98,106],"target":[79,85]}]},"1:18":{"sourceText":"ὅτι ἔλεγον ὑμῖν Ἐπ’ ἐσχάτου τοῦ χρόνου ἔσονται ἐμπαῖκται κατὰ τὰς ἑαυτῶν ἐπιθυμίας πορευόμενοι τῶν ἀσεβειῶν.","targetText":"when they said to you, “In the last times there will be scoffers who will follow after their own ungodly desires.”","groups":[{"id":0,"source":[0,3],"target":[0,4]},{"id":1,"source":[4,10],"target":[5,14]},{"id":2,"source":[11,15],"target":[15,21]},{"id":3,"source":[16,19],"target":[24,26]},{"id":4,"source":[20,27],"target":[27,35]},{"id":6,"source":[32,38],"target":[36,41]},{"id":7,"source":[39,46],"target":[42,55]},{"id":8,"source":[47,56],"target":[56,64]},{"id":13,"source":[83,94],"target":[65,80]},{"id":9,"source":[57,61],"target":[81,86]},{"id":11,"source":[66,72],"target":[87,96]},{"id":15,"source":[99,108],"target":[97,104]},{"id":12,"source":[73,82],"target":[105,112]}]},"1:19":{"sourceText":"Οὗτοί εἰσιν οἱ ἀποδιορίζοντες, ψυχικοί, Πνεῦμα μὴ ἔχοντες.","targetText":"These are the ones who cause divisions, who are worldly and devoid of the Spirit.","groups":[{"id":0,"source":[0,5],"target":[0,5]},{"id":1,"source":[6,11],"target":[6,9]},{"id":2,"source":[12,14],"target":[10,22]},{"id":3,"source":[15,30],"target":[23,38]},{"id":4,"source":[31,39],"target":[40,55]},{"id":7,"source":[50,58],"target":[56,69]},{"id":5,"source":[40,46],"target":[70,80]}]},"1:20":{"sourceText":"ὑμεῖς δέ, ἀγαπητοί, ἐποικοδομοῦντες ἑαυτοὺς τῇ ἁγιωτάτῃ ὑμῶν πίστει, ἐν Πνεύματι Ἁγίῳ προσευχόμενοι,","targetText":"But you, beloved, by building yourselves up in your most holy faith and praying in the Holy Spirit,","groups":[{"id":1,"source":[6,9],"target":[0,3]},{"id":0,"source":[0,5],"target":[4,7]},{"id":2,"source":[10,19],"target":[9,16]},{"id":3,"source":[20,35],"target":[18,29]},{"id":4,"source":[36,43],"target":[30,43]},{"id":5,"source":[44,46],"target":[44,46]},{"id":7,"source":[56,60],"target":[47,51]},{"id":6,"source":[47,55],"target":[52,61]},{"id":8,"source":[61,68],"target":[62,67]},{"id":12,"source":[86,100],"target":[68,79]},{"id":9,"source":[69,71],"target":[80,82]},{"id":11,"source":[81,85],"target":[83,91]},{"id":10,"source":[72,80],"target":[92,98]}]},"1:21":{"sourceText":"ἑαυτοὺς ἐν ἀγάπῃ Θεοῦ τηρήσατε, προσδεχόμενοι τὸ ἔλεος τοῦ Κυρίου ἡμῶν Ἰησοῦ Χριστοῦ εἰς ζωὴν αἰώνιον.","targetText":"keep yourselves in the love of God as you await the mercy of our Lord Jesus Christ to bring you eternal life.","groups":[{"id":4,"source":[22,31],"target":[0,4]},{"id":0,"source":[0,7],"target":[5,15]},{"id":1,"source":[8,10],"target":[16,18]},{"id":2,"source":[11,16],"target":[19,27]},{"id":3,"source":[17,21],"target":[28,34]},{"id":5,"source":[32,45],"target":[35,47]},{"id":6,"source":[46,48],"target":[48,51]},{"id":7,"source":[49,54],"target":[52,57]},{"id":10,"source":[66,70],"target":[58,64]},{"id":9,"source":[59,65],"target":[65,69]},{"id":11,"source":[71,76],"target":[70,75]},{"id":12,"source":[77,84],"target":[76,82]},{"id":13,"source":[85,88],"target":[83,95]},{"id":15,"source":[94,102],"target":[96,103]},{"id":14,"source":[89,93],"target":[104,108]}]},"1:22":{"sourceText":"καὶ οὓς μὲν ἐλεᾶτε διακρινομένους","targetText":"And indeed, have mercy on those who doubt;","groups":[{"id":0,"so