{"schemaVersion":1,"book":"Philemon","sourceId":"N1904","targetId":"BSB","provenance":{"url":"https://bereanbible.com/bsb_tables.tsv","license":"CC0","licenseUrl":"https://berean.bible/terms.htm","tableSha256":"09bbee6f9fe4fa22b5df28e8a9ffa99bf9c33435f4eb8c47c2dc221d855d35cb","targetSha256":"8afd83b240d4ac4168127d4d039896a2245883d431e9125899b6adcbd5b32285","greekSha256":"3beee6abb6302f691110fe0fc949fc195593b999cf2d0e463c9b573c1bb67150"},"method":"Publisher row links transferred only when the whole Greek and English verse word sequences agree; Greek comparison ignores accents, case and punctuation. English comparison ignores case and punctuation. No inferred synonym or Strong-number matching.","verses":{"1:1":{"sourceText":"Παῦλος δέσμιος Χριστοῦ Ἰησοῦ καὶ Τιμόθεος ὁ ἀδελφὸς Φιλήμονι τῷ ἀγαπητῷ καὶ συνεργῷ ἡμῶν","targetText":"Paul, a prisoner of Christ Jesus, and Timothy our brother,  To Philemon our beloved fellow worker,","groups":[{"id":0,"source":[0,6],"target":[0,4]},{"id":1,"source":[7,14],"target":[6,16]},{"id":2,"source":[15,22],"target":[17,26]},{"id":3,"source":[23,28],"target":[27,32]},{"id":4,"source":[29,32],"target":[34,37]},{"id":5,"source":[33,41],"target":[38,45]},{"id":6,"source":[42,43],"target":[46,49]},{"id":7,"source":[44,51],"target":[50,57]},{"id":8,"source":[52,60],"target":[60,71]},{"id":13,"source":[84,88],"target":[72,75]},{"id":10,"source":[64,71],"target":[76,83]},{"id":12,"source":[76,83],"target":[84,97]}]},"1:2":{"sourceText":"καὶ Ἀπφίᾳ τῇ ἀδελφῇ καὶ Ἀρχίππῳ τῷ συστρατιώτῃ ἡμῶν καὶ τῇ κατ’ οἶκόν σου ἐκκλησίᾳ·","targetText":"to Apphia our sister, to Archippus our fellow soldier, and to the church that meets at your house:","groups":[{"id":1,"source":[4,9],"target":[0,9]},{"id":2,"source":[10,12],"target":[10,13]},{"id":3,"source":[13,19],"target":[14,20]},{"id":5,"source":[24,31],"target":[22,34]},{"id":8,"source":[47,51],"target":[35,38]},{"id":7,"source":[35,46],"target":[39,53]},{"id":9,"source":[52,55],"target":[55,58]},{"id":10,"source":[56,58],"target":[59,65]},{"id":14,"source":[74,83],"target":[66,72]},{"id":11,"source":[59,63],"target":[73,86]},{"id":13,"source":[70,73],"target":[87,91]},{"id":12,"source":[64,69],"target":[92,97]}]},"1:3":{"sourceText":"χάρις ὑμῖν καὶ εἰρήνη ἀπὸ Θεοῦ Πατρὸς ἡμῶν καὶ Κυρίου Ἰησοῦ Χριστοῦ.","targetText":"Grace and peace to you from God our Father and the Lord Jesus Christ.","groups":[{"id":0,"source":[0,5],"target":[0,5]},{"id":2,"source":[11,14],"target":[6,9]},{"id":3,"source":[15,21],"target":[10,15]},{"id":1,"source":[6,10],"target":[16,22]},{"id":4,"source":[22,25],"target":[23,27]},{"id":5,"source":[26,30],"target":[28,31]},{"id":7,"source":[38,42],"target":[32,35]},{"id":6,"source":[31,37],"target":[36,42]},{"id":8,"source":[43,46],"target":[43,46]},{"id":9,"source":[47,53],"target":[47,55]},{"id":10,"source":[54,59],"target":[56,61]},{"id":11,"source":[60,68],"target":[62,68]}]},"1:4":{"sourceText":"Εὐχαριστῶ τῷ Θεῷ μου πάντοτε μνείαν σου ποιούμενος ἐπὶ τῶν προσευχῶν μου,","targetText":"I always thank my God, remembering you in my prayers,","groups":[{"id":0,"source":[0,9],"target":[0,14]},{"id":3,"source":[17,20],"target":[15,17]},{"id":2,"source":[13,16],"target":[18,21]},{"id":7,"source":[40,50],"target":[23,34]},{"id":6,"source":[36,39],"target":[35,38]},{"id":8,"source":[51,54],"target":[39,41]},{"id":11,"source":[69,73],"target":[42,44]},{"id":10,"source":[59,68],"target":[45,52]}]},"1:5":{"sourceText":"ἀκούων σου τὴν ἀγάπην καὶ τὴν πίστιν ἣν ἔχεις πρὸς τὸν Κύριον Ἰησοῦν καὶ εἰς πάντας τοὺς ἁγίους,","targetText":"because I hear about your faith in the Lord Jesus and your love for all the saints.","groups":[{"id":0,"source":[0,6],"target":[0,20]},{"id":8,"source":[40,45],"target":[21,25]},{"id":6,"source":[30,36],"target":[26,31]},{"id":9,"source":[46,50],"target":[32,34]},{"id":10,"source":[51,54],"target":[35,38]},{"id":11,"source":[55,61],"target":[39,43]},{"id":12,"source":[62,68],"target":[44,49]},{"id":13,"source":[69,72],"target":[50,53]},{"id":1,"source":[7,10],"target":[54,58]},{"id":3,"source":[15,21],"target":[59,63]},{"id":14,"source":[73,76],"target":[64,67]},{"id":15,"source":[77,83],"target":[68,71]},{"id":16,"source":[84,88],"target":[72,75]},{"id":17,"source":[89,96],"target":[76,82]}]},"1:6":{"sourceText":"ὅπως ἡ κοινωνία τῆς πίστεώς σου ἐνεργὴς γένηται ἐν ἐπιγνώσει παντὸς ἀγαθοῦ τοῦ ἐν ἡμῖν εἰς Χριστόν·","targetText":"I pray that your partnership in the faith may become effective as you fully acknowledge every good thing that is ours in Christ.","groups":[{"id":0,"source":[0,4],"target":[0,11]},{"id":5,"source":[28,31],"target":[12,16]},{"id":2,"source":[7,15],"target":[17,28]},{"id":3,"source":[16,19],"target":[29,35]},{"id":4,"source":[20,27],"target":[36,41]},{"id":7,"source":[40,47],"target":[42,52]},{"id":6,"source":[32,39],"target":[53,62]},{"id":8,"source":[48,50],"target":[63,65]},{"id":9,"source":[51,60],"target":[66,87]},{"id":10,"source":[61,67],"target":[88,93]},{"id":11,"source":[68,74],"target":[94,104]},{"id":12,"source":[75,78],"target":[105,112]},{"id":14,"source":[82,86],"target":[113,117]},{"id":15,"source":[87,90],"target":[118,120]},{"id":16,"source":[91,99],"target":[121,127]}]},"1:7":{"sourceText":"χαρὰν γὰρ πολλὴν ἔσχον καὶ παράκλησιν ἐπὶ τῇ ἀγάπῃ σου, ὅτι τὰ σπλάγχνα τῶν ἁγίων ἀναπέπαυται διὰ σοῦ, ἀδελφέ.","targetText":"I take great joy and encouragement in your love, because you, brother, have refreshed the hearts of the saints.","groups":[{"id":3,"source":[17,22],"target":[0,6]},{"id":2,"source":[10,16],"target":[7,12]},{"id":0,"source":[0,5],"target":[13,16]},{"id":4,"source":[23,26],"target":[17,20]},{"id":5,"source":[27,37],"target":[21,34]},{"id":6,"source":[38,41],"target":[35,37]},{"id":9,"source":[51,55],"target":[38,42]},{"id":8,"source":[45,50],"target":[43,47]},{"id":10,"source":[56,59],"target":[49,56]},{"id":17,"source":[98,102],"target":[57,60]},{"id":18,"source":[103,110],"target":[62,69]},{"id":15,"source":[82,93],"target":[71,85]},{"id":11,"source":[60,62],"target":[86,89]},{"id":12,"source":[63,71],"target":[90,96]},{"id":13,"source":[72,75],"target":[97,103]},{"id":14,"source":[76,81],"target":[104,110]}]},"1:8":{"sourceText":"Διό, πολλὴν ἐν Χριστῷ παρρησίαν ἔχων ἐπιτάσσειν σοι τὸ ἀνῆκον,","targetText":"So although in Christ I am bold enough to order you to do what is proper,","groups":[{"id":0,"source":[0,4],"target":[0,2]},{"id":2,"source":[12,14],"target":[3,14]},{"id":3,"source":[15,21],"target":[15,21]},{"id":5,"source":[32,36],"target":[22,26]},{"id":4,"source":[22,31],"target":[27,31]},{"id":1,"source":[5,11],"target":[32,38]},{"id":6,"source":[37,47],"target":[39,47]},{"id":7,"source":[48,51],"target":[48,57]},{"id":8,"source":[52,54],"target":[58,65]},{"id":9,"source":[55,62],"target":[66,72]}]},"1:9":{"sourceText":"διὰ τὴν ἀγάπην μᾶλλον παρακαλῶ, τοιοῦτος ὢν ὡς Παῦλος πρεσβύτης νυνὶ δὲ καὶ δέσμιος Χριστοῦ Ἰησοῦ,","targetText":"I prefer to appeal on the basis of love. For I, Paul, am now aged, and a prisoner of Christ Jesus as well.","groups":[{"id":4,"source":[22,31],"target":[0,18]},{"id":0,"source":[0,3],"target":[19,34]},{"id":2,"source":[8,14],"target":[35,39]},{"id":7,"source":[44,46],"target":[41,44]},{"id":5,"source":[32,40],"target":[45,46]},{"id":8,"source":[47,53],"target":[48,52]},{"id":6,"source":[41,43],"target":[54,56]},{"id":10,"source":[64,68],"target":[57,60]},{"id":9,"source":[54,63],"target":[61,65]},{"id":11,"source":[69,71],"target":[67,70]},{"id":13,"source":[76,83],"target":[71,81]},{"id":14,"source":[84,91],"target":[82,91]},{"id":15,"source":[92,98],"target":[92,97]},{"id":12,"source":[72,75],"target":[98,105]}]},"1:10":{"sourceText":"παρακαλῶ σε περὶ τοῦ ἐμοῦ τέκνου, ὃν ἐγέννησα ἐν τοῖς δεσμοῖς, Ὀνήσιμον,","targetText":"I appeal to you for my child Onesimus, whose father I became while I was in chains.","groups":[{"id":0,"source":[0,8],"target":[0,8]},{"id":1,"source":[9,11],"target":[9,15]},{"id":2,"source":[12,16],"target":[16,19]},{"id":4,"source":[21,25],"target":[20,22]},{"id":5,"source":[26,33],"target":[23,28]},{"id":11,"source":[63,72],"target":[29,37]},{"id":6,"source":[34,36],"target":[39,44]},{"id":7,"source":[37,45],"target":[45,60]},{"id":8,"source":[46,48],"target":[61,75]},{"id":10,"source":[54,62],"target":[76,82]}]},"1:11":{"sourceText":"τόν ποτέ σοι ἄχρηστον νυνὶ δὲ καὶ σοὶ καὶ ἐμοὶ εὔχρηστον,","targetText":"Formerly he was useless to you, but now he has become useful both to you and to me.","groups":[{"id":1,"source":[4,8],"target":[0,8]},{"id":3,"source":[13,21],"target":[9,23]},{"id":2,"source":[9,12],"target":[24,30]},{"id":5,"source":[27,29],"target":[32,35]},{"id":4,"source":[22,26],"target":[36,39]},{"id":10,"source":[47,57],"target":[40,60]},{"id":6,"source":[30,33],"target":[61,65]},{"id":7,"source":[34,37],"target":[66,72]},{"id":8,"source":[38,41],"target":[73,76]},{"id":9,"source":[42,46],"target":[77,82]}]},"1:12":{"sourceText":"ὃν ἀνέπεμψά σοι αὐτόν, τοῦτ’ ἔστιν τὰ ἐμὰ σπλάγχνα·","targetText":"I am sending back to you him who is my very heart.","groups":[{"id":1,"source":[3,11],"target":[0,17]},{"id":2,"source":[12,15],"target":[18,24]},{"id":3,"source":[16,22],"target":[25,28]},{"id":4,"source":[23,28],"target":[29,32]},{"id":5,"source":[29,34],"target":[33,35]},{"id":7,"source":[38,41],"target":[36,38]},{"id":8,"source":[42,51],"target":[39,49]}]},"1:13":{"sourceText":"ὃν ἐγὼ ἐβουλόμην πρὸς ἐμαυτὸν κατέχειν, ἵνα ὑπὲρ σοῦ μοι διακονῇ ἐν τοῖς δεσμοῖς τοῦ εὐαγγελίου,","targetText":"I would have liked to keep him with me, so that on your behalf he could minister to me in my chains for the gospel.","groups":[{"id":1,"source":[3,6],"target":[0,1]},{"id":2,"source":[7,16],"target":[2,18]},{"id":5,"source":[30,39],"target":[19,26]},{"id":0,"source":[0,2],"target":[27,30]},{"id":3,"source":[17,21],"target":[31,35]},{"id":4,"source":[22,29],"target":[36,38]},{"id":6,"source":[40,43],"target":[40,47]},{"id":8,"source":[49,52],"target":[48,62]},{"id":10,"source":[57,64],"target":[63,83]},{"id":9,"source":[53,56],"target":[84,86]},{"id":11,"source":[65,67],"target":[87,89]},{"id":12,"source":[68,72],"target":[90,92]},{"id":13,"source":[73,80],"target":[93,99]},{"id":14,"source":[81,84],"target":[100,107]},{"id":15,"source":[85,96],"target":[108,114]}]},"1:14":{"sourceText":"χωρὶς δὲ τῆς σῆς γνώμης οὐδὲν ἠθέλησα ποιῆσαι, ἵνα μὴ ὡς κατὰ ἀνάγκην τὸ ἀγαθόν σου ᾖ ἀλλὰ κατὰ ἑκούσιον.","targetText":"But I did not want to do anything without your consent, so that your goodness will not be out of compulsion, but by your own free will.","groups":[{"id":1,"source":[6,8],"target":[0,3]},{"id":6,"source":[30,37],"target":[4,18]},{"id":7,"source":[38,46],"target":[19,24]},{"id":5,"source":[24,29],"target":[25,33]},{"id":0,"source":[0,5],"target":[34,41]},{"id":3,"source":[13,16],"target":[42,46]},{"id":4,"source":[17,23],"target":[47,54]},{"id":8,"source":[47,50],"target":[56,63]},{"id":15,"source":[80,83],"target":[64,68]},{"id":14,"source":[73,79],"target":[69,77]},{"id":16,"source":[84,85],"target":[78,89]},{"id":11,"source":[57,61],"target":[90,96]},{"id":12,"source":[62,69],"target":[97,107]},{"id":17,"source":[86,90],"target":[109,112]},{"id":18,"source":[91,95],"target":[113,115]},{"id":19,"source":[96,105],"target":[116,134]}]},"1:15":{"sourceText":"τάχα γὰρ διὰ τοῦτο ἐχωρίσθη πρὸς ὥραν, ἵνα αἰώνιον αὐτὸν ἀπέχῃς,","targetText":"For perhaps this is why he was separated from you for a while, so that you might have him back for good—","groups":[{"id":1,"source":[5,8],"target":[0,3]},{"id":0,"source":[0,4],"target":[4,11]},{"id":2,"source":[9,12],"target":[12,23]},{"id":4,"source":[19,27],"target":[24,49]},{"id":5,"source":[28,32],"target":[50,53]},{"id":6,"source":[33,38],"target":[54,61]},{"id":7,"source":[39,42],"target":[63,70]},{"id":10,"source":[57,64],"target":[71,94]},{"id":8,"source":[43,50],"target":[95,103]}]},"1:16":{"sourceText":"οὐκέτι ὡς δοῦλον ἀλλὰ ὑπὲρ δοῦλον, ἀδελφὸν ἀγαπητόν, μάλιστα ἐμοί, πόσῳ δὲ μᾶλλον σοὶ καὶ ἐν σαρκὶ καὶ ἐν Κυρίῳ.","targetText":"no longer as a slave, but better than a slave, as a beloved brother. He is especially beloved to me, but even more so to you, both in person and in the Lord.","groups":[{"id":0,"source":[0,6],"target":[0,9]},{"id":1,"source":[7,9],"target":[10,12]},{"id":2,"source":[10,16],"target":[13,20]},{"id":3,"source":[17,21],"target":[22,25]},{"id":4,"source":[22,26],"target":[26,37]},{"id":5,"source":[27,34],"target":[38,45]},{"id":7,"source":[43,52],"target":[47,59]},{"id":6,"source":[35,42],"target":[60,67]},{"id":8,"source":[53,60],"target":[69,93]},{"id":9,"source":[61,66],"target":[94,99]},{"id":11,"source":[72,74],"target":[101,104]},{"id":10,"source":[67,71],"target":[105,117]},{"id":13,"source":[82,85],"target":[118,124]},{"id":14,"source":[86,89],"target":[126,130]},{"id":15,"source":[90,92],"target":[131,133]},{"id":16,"source":[93,98],"target":[134,140]},{"id":17,"source":[99,102],"target":[141,144]},{"id":18,"source":[103,105],"target":[145,147]},{"id":19,"source":[106,112],"target":[148,156]}]},"1:17":{"sourceText":"εἰ οὖν με ἔχεις κοινωνόν, προσλαβοῦ αὐτὸν ὡς ἐμέ.","targetText":"So if you consider me a partner, receive him as you would receive me.","groups":[{"id":1,"source":[3,6],"target":[0,2]},{"id":0,"source":[0,2],"target":[3,5]},{"id":3,"source":[10,15],"target":[6,18]},{"id":2,"source":[7,9],"target":[19,21]},{"id":4,"source":[16,25],"target":[22,31]},{"id":5,"source":[26,35],"target":[33,40]},{"id":6,"source":[36,41],"target":[41,44]},{"id":7,"source":[42,44],"target":[45,65]},{"id":8,"source":[45,49],"target":[66,68]}]},"1:18":{"sourceText":"εἰ δέ τι ἠδίκησέν σε ἢ ὀφείλει, τοῦτο ἐμοὶ ἐλλόγα·","targetText":"But if he has wronged you in any way or owes you anything, charge it to my account.","groups":[{"id":1,"source":[3,5],"target":[0,3]},{"id":0,"source":[0,2],"target":[4,6]},{"id":3,"source":[9,17],"target":[7,21]},{"id":4,"source":[18,20],"target":[22,25]},{"id":2,"source":[6,8],"target":[26,36]},{"id":5,"source":[21,22],"target":[37,39]},{"id":6,"source":[23,31],"target":[40,57]},{"id":9,"source":[43,50],"target":[59,82]}]},"1:19":{"sourceText":"ἐγὼ Παῦλος ἔγραψα τῇ ἐμῇ χειρί, ἐγὼ ἀποτίσω· ἵνα μὴ λέγω σοι ὅτι καὶ σεαυτόν μοι προσοφείλεις.","targetText":"I, Paul, write this with my own hand. I will repay it—not to mention that you owe me your very self.","groups":[{"id":0,"source":[0,3],"target":[0,1]},{"id":1,"source":[4,10],"target":[3,7]},{"id":2,"source":[11,17],"target":[9,19]},{"id":3,"source":[18,20],"target":[20,24]},{"id":4,"source":[21,24],"target":[25,31]},{"id":5,"source":[25,31],"target":[32,36]},{"id":6,"source":[32,35],"target":[38,39]},{"id":7,"source":[36,44],"target":[40,53]},{"id":9,"source":[49,51],"target":[54,57]},{"id":8,"source":[45,48],"target":[58,60]},{"id":10,"source":[52,56],"target":[61,68]},{"id":12,"source":[61,64],"target":[69,73]},{"id":16,"source":[81,94],"target":[74,81]},{"id":15,"source":[77,80],"target":[82,84]},{"id":14,"source":[69,76],"target":[85,99]}]},"1:20":{"sourceText":"ναί, ἀδελφέ, ἐγώ σου ὀναίμην ἐν Κυρίῳ· ἀνάπαυσόν μου τὰ σπλάγχνα ἐν Χριστῷ.","targetText":"Yes, brother, let me have some benefit from you in the Lord. Refresh my heart in Christ.","groups":[{"id":0,"source":[0,4],"target":[0,3]},{"id":1,"source":[5,12],"target":[5,12]},{"id":4,"source":[21,28],"target":[14,38]},{"id":3,"source":[17,20],"target":[39,47]},{"id":5,"source":[29,31],"target":[48,50]},{"id":6,"source":[32,38],"target":[51,59]},{"id":7,"source":[39,48],"target":[61,68]},{"id":8,"source":[49,52],"target":[69,71]},{"id":10,"source":[56,64],"target":[72,77]},{"id":11,"source":[65,67],"target":[78,80]},{"id":12,"source":[68,75],"target":[81,87]}]},"1:21":{"sourceText":"Πεποιθὼς τῇ ὑπακοῇ σου ἔγραψά σοι, εἰδὼς ὅτι καὶ ὑπὲρ ἃ λέγω ποιήσεις.","targetText":"Confident of your obedience, I write to you, knowing that you will do even more than I ask.","groups":[{"id":0,"source":[0,8],"target":[0,12]},{"id":3,"source":[19,22],"target":[13,17]},{"id":2,"source":[12,18],"target":[18,27]},{"id":4,"source":[23,29],"target":[29,36]},{"id":5,"source":[30,34],"target":[37,43]},{"id":6,"source":[35,40],"target":[45,52]},{"id":7,"source":[41,44],"target":[53,57]},{"id":12,"source":[61,70],"target":[58,69]},{"id":8,"source":[45,48],"target":[70,74]},{"id":9,"source":[49,53],"target":[75,79]},{"id":10,"source":[54,55],"target":[80,84]},{"id":11,"source":[56,60],"target":[85,90]}]},"1:22":{"sourceText":"ἅμα δὲ καὶ ἑτοίμαζέ μοι ξενίαν· ἐλπίζω γὰρ ὅτι διὰ τῶν προσευχῶν ὑμῶν χαρισθήσομαι ὑμῖν.","targetText":"In the meantime, prepare a guest room for me, because I hope that through your prayers I will be restored to you.","groups":[{"id":1,"source":[4,6],"target":[0,15]},{"id":3,"source":[11,19],"target":[17,24]},{"id":5,"source":[24,31],"target":[25,37]},{"id":4,"source":[20,23],"target":[38,44]},{"id":7,"source":[39,42],"target":[46,53]},{"id":6,"source":[32,38],"target":[54,60]},{"id":8,"source":[43,46],"target":[61,65]},{"id":9,"source":[47,50],"target":[66,73]},{"id":12,"source":[65,69],"target":[74,78]},{"id":11,"source":[55,64],"target":[79,86]},{"id":13,"source":[70,82],"target":[87,105]},{"id":14,"source":[83,88],"target":[106,112]}]},"1:23":{"sourceText":"Ἀσπάζεταί σε Ἐπαφρᾶς ὁ συναιχμάλωτός μου ἐν Χριστῷ Ἰησοῦ,","targetText":"Epaphras, my fellow prisoner in Christ Jesus, sends you greetings,","groups":[{"id":2,"source":[13,20],"target":[0,8]},{"id":5,"source":[37,40],"target":[10,12]},{"id":4,"source":[23,36],"target":[13,28]},{"id":6,"source":[41,43],"target":[29,31]},{"id":7,"source":[44,50],"target":[32,38]},{"id":8,"source":[51,57],"target":[39,44]},{"id":0,"source":[0,9],"target":[46,65]}]},"1:24":{"sourceText":"Μᾶρκος, Ἀρίσταρχος, Δημᾶς, Λουκᾶς, οἱ συνεργοί μου.","targetText":"as do Mark, Aristarchus, Demas, and Luke, my fellow workers.","groups":[{"id":0,"source":[0,7],"target":[0,10]},{"id":1,"source":[8,19],"target":[12,23]},{"id":2,"source":[20,26],"target":[25,30]},{"id":3,"source":[27,34],"target":[32,40]},{"id":6,"source":[47,51],"target":[42,44]},{"id":5,"source":[38,46],"target":[45,59]}]},"1:25":{"sourceText":"Ἡ χάρις τοῦ Κυρίου Ἰησοῦ Χριστοῦ μετὰ τοῦ πνεύματος ὑμῶν.","targetText":"The grace of the Lord Jesus Christ be with your spirit.","groups":[{"id":0,"source":[0,1],"target":[0,3]},{"id":1,"source":[2,7],"target":[4,9]},{"id":2,"source":[8,11],"target":[10,16]},{"id":3,"source":[12,18],"target":[17,21]},{"id":4,"source":[19,24],"target":[22,27]},{"id":5,"source":[25,32],"target":[28,34]},{"id":6,"source":[33,37],"target":[35,42]},{"id":9,"source":[52,57],"target":[43,47]},{"id":8,"source":[42,51],"target":[48,54]}]}},"unavailable":{}}
