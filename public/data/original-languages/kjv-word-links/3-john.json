ers to the truth.","groups":[{"id":1,"source":[0,5],"sourceRanges":[[0,5]],"target":[0,2],"targetRanges":[[0,2]]},{"id":2,"source":[6,9],"sourceRanges":[[6,9]],"target":[3,12],"targetRanges":[[3,12]]},{"id":3,"source":[10,19],"sourceRanges":[[10,19]],"target":[13,18],"targetRanges":[[13,18]]},{"id":5,"source":[38,48],"sourceRanges":[[38,48]],"target":[30,34],"targetRanges":[[30,34]]},{"id":6,"source":[49,52],"sourceRanges":[[49,52]],"target":[36,40],"targetRanges":[[36,40]]},{"id":7,"source":[62,70],"sourceRanges":[[62,70]],"target":[41,52],"targetRanges":[[41,52]]},{"id":8,"source":[53,61],"sourceRanges":[[53,61]],"target":[53,66],"targetRanges":[[53,66]]},{"id":9,"source":[71,82],"sourceRanges":[[71,82]],"target":[70,79],"targetRanges":[[70,79]]}]},"1:9":{"sourceText":"Ἔγραψά τι τῇ ἐκκλησίᾳ· ἀλλ’ ὁ φιλοπρωτεύων αὐτῶν Διοτρεφὴς οὐκ ἐπιδέχεται ἡμᾶς.","targetText":"I wrote unto the church: but Diotrephes, who loveth to have the preeminence among them, receiveth us not.","groups":[{"id":1,"source":[0,6],"sourceRanges":[[0,6]],"target":[0,12],"targetRanges":[[0,12]]},{"id":2,"source":[10,22],"sourceRanges":[[10,22]],"target":[13,23],"targetRanges":[[13,23]]},{"id":3,"source":[23,27],"sourceRanges":[[23,27]],"target":[25,28],"targetRanges":[[25,28]]},{"id":4,"source":[49,58],"sourceRanges":[[49,58]],"target":[29,39],"targetRanges":[[29,39]]},{"id":5,"source":[30,42],"sourceRanges":[[30,42]],"target":[41,75],"targetRanges":[[41,75]]},{"id":6,"source":[43,48],"sourceRanges":[[43,48]],"target":[76,86],"targetRanges":[[76,86]]},{"id":7,"source":[63,73],"sourceRanges":[[63,73]],"target":[88,97],"targetRanges":[[88,97]]},{"id":8,"source":[74,79],"sourceRanges":[[74,79]],"target":[98,100],"targetRanges":[[98,100]]},{"id":9,"source":[59,62],"sourceRanges":[[59,62]],"target":[101,104],"targetRanges":[[101,104]]}]},"1:10":{"sourceText":"διὰ τοῦτο, ἐὰν ἔλθω, ὑπομνήσω αὐτοῦ τὰ ἔργα ἃ ποιεῖ λόγοις πονηροῖς φλυαρῶν ἡμᾶς, καὶ μὴ ἀρκούμενος ἐπὶ τούτοις οὔτε αὐτὸς ἐπιδέχεται τοὺς ἀδελφοὺς καὶ τοὺς βουλομένους κωλύει καὶ ἐκ τῆς ἐκκλησίας ἐκβάλλει.","targetText":"Wherefore, if I come, I will remember his deeds which he doeth, prating against us with malicious words: and not content therewith, neither doth he himself receive the brethren, and forbiddeth them that would, and casteth them out of the church.","groups":[{"id":3,"source":[4,10],"sourceRanges":[[4,10]],"target":[0,9],"targetRanges":[[0,9]]},{"id":4,"source":[11,14],"sourceRanges":[[11,14]],"target":[11,13],"targetRanges":[[11,13]]},{"id":5,"source":[15,20],"sourceRanges":[[15,20]],"target":[14,20],"targetRanges":[[14,20]]},{"id":6,"source":[21,29],"sourceRanges":[[21,29]],"target":[22,37],"targetRanges":[[22,37]]},{"id":7,"source":[30,35],"sourceRanges":[[30,35]],"target":[38,41],"targetRanges":[[38,41]]},{"id":8,"source":[36,43],"sourceRanges":[[36,43]],"target":[42,47],"targetRanges":[[42,47]]},{"id":9,"source":[44,45],"sourceRanges":[[44,45]],"target":[48,53],"targetRanges":[[48,53]]},{"id":10,"source":[46,51],"sourceRanges":[[46,51]],"target":[54,62],"targetRanges":[[54,62]]},{"id":11,"source":[68,75],"sourceRanges":[[68,75]],"target":[64,79],"targetRanges":[[64,79]]},{"id":12,"source":[76,81],"sourceRanges":[[76,81]],"target":[80,82],"targetRanges":[[80,82]]},{"id":13,"source":[52,58],"sourceRanges":[[52,58]],"target":[83,87],"targetRanges":[[83,87],[98,103]]},{"id":14,"source":[59,67],"sourceRanges":[[59,67]],"target":[88,97],"targetRanges":[[88,97]]},{"id":16,"source":[82,85],"sourceRanges":[[82,85]],"target":[105,108],"targetRanges":[[105,108]]},{"id":17,"source":[86,88],"sourceRanges":[[86,88]],"target":[109,112],"targetRanges":[[109,112]]},{"id":18,"source":[89,99],"sourceRanges":[[89,99]],"target":[113,120],"targetRanges":[[113,120]]},{"id":19,"source":[104,111],"sourceRanges":[[104,111]],"target":[121,130],"targetRanges":[[121,130]]},{"id":20,"source":[112,116],"sourceRanges":[[112,116]],"target":[132,139],"targetRanges":[[132,139]]},{"id":21,"source":[123,133],"sourceRanges":[