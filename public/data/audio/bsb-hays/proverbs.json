{"schemaVersion":1,"translation":"BSB","book":"Proverbs","chapters":{"1":{"verses":[],"totalVerses":33},"2":{"verses":[],"totalVerses":22},"3":{"verses":[],"totalVerses":35},"4":{"verses":[],"totalVerses":27},"5":{"verses":[],"totalVerses":23},"6":{"verses":[],"totalVerses":35},"7":{"verses":[],"totalVerses":27},"8":{"verses":[],"totalVerses":36},"9":{"verses":[],"totalVerses":18},"10":{"verses":[],"totalVerses":32},"11":{"verses":[],"totalVerses":31},"12":{"verses":[],"totalVerses":28},"13":{"verses":[],"totalVerses":25},"14":{"verses":[],"totalVerses":35},"15":{"verses":[],"totalVerses":33},"16":{"verses":[],"totalVerses":33},"17":{"verses":[],"totalVerses":28},"18":{"verses":[],"totalVerses":24},"19":{"verses":[],"totalVerses":29},"20":{"verses":[],"totalVerses":30},"21":{"verses":[],"totalVerses":31},"22":{"verses":[],"totalVerses":29},"23":{"verses":[],"totalVerses":35},"24":{"verses":[],"totalVerses":34},"25":{"verses":[{"verse":1,"start":4.44,"end":10.66,"text":"these are additional proverbs of solomon which were copied by the men of hezekiah king of judah"}],"totalVerses":28},"26":{"verses":[],"totalVerses":28},"27":{"verses":[],"totalVerses":27},"28":{"verses":[],"totalVerses":28},"29":{"verses":[],"totalVerses":27},"30":{"verses":[{"verse":21,"start":196.79,"end":202.01,"text":"under three things the earth trembles under four it cannot bear up"},{"verse":24,"start":212.17,"end":220.35,"text":"four things on earth are small yet they are exceedingly wise"},{"verse":25,"start":221.15,"end":226.33,"text":"the ants are creatures of little strength yet they store up their food in the summer"},{"verse":27,"start":229.51,"end":238.19,"text":"the locusts have no king yet they all advance in formation"},{"verse":29,"start":247.37,"end":253.45,"text":"there are three things that are stately in their stride and four that are impressive in their walk"},{"verse":30,"start":254.53,"end":259.59,"text":"a lion mighty among beasts refusing to retreat before anything"}],"totalVerses":33},"31":{"verses":[{"verse":1,"start":4.4,"end":9.06,"text":"these are the words of king lemuel the burden that his mother taught him"}],"totalVerses":31}}}
